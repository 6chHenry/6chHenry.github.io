---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryCard from '../../components/GalleryCard.astro';
import GalleryImage from '../../components/GalleryImage.astro';
import GalleryLightbox from '../../components/GalleryLightbox.astro';
import { buildContentUrl, formatDate, sortByRecency } from '../../utils/content';

const hiddenCities = new Set(['osaka', 'kyoto', 'nara', 'uji', 'kobe', 'himeji', 'guangzhou', 'hong-kong', 'macau', 'wuhan', 'lushan', 'nanchang']);
const base = import.meta.env.BASE_URL;
const allEntries = await getCollection('gallery', ({ data }) => !data.draft);
const entries = sortByRecency(allEntries).filter((entry) => {
  const parts = entry.id.split('/');
  const slug = (parts[parts.length - 1] || '').replace(/\.md$/, '');
  if (parts[0] === 'photography' && hiddenCities.has(slug)) return false;
  return true;
});

const getEntrySlug = (id: string) => {
  const parts = id.split('/');
  return (parts[parts.length - 1] || '').replace(/\.md$/, '');
};

/* 有专属沉浸页的旅程，卡片直接跳过去 */
const immersivePages: Record<string, string> = {
  'photography/japan.md': 'gallery/japan/',
  'photography/greater-bay-area.md': 'gallery/bay-area/',
  'photography/hubei-jiangxi.md': 'gallery/hubei-jiangxi/',
  'photography/summer-2026-four-cities.md': 'gallery/four-cities/',
};
const entryHref = (id: string) =>
  immersivePages[id] ? `${base}${immersivePages[id]}` : buildContentUrl('gallery', id, base);

/* 多城旅程由多个城市条目组成，照片数要逐城累加；单城旅程就是它自己 */
const TRIP_CITIES: Record<string, string[]> = {
  'hubei-jiangxi': ['wuhan', 'lushan', 'nanchang'],
  geermu: ['geermu'],
  'greater-bay-area': ['guangzhou', 'macau', 'hong-kong'],
  japan: ['osaka', 'nara', 'uji', 'kyoto', 'kobe', 'himeji'],
  'summer-2026-four-cities': ['summer-2026-four-cities'],
};

const entryBySlug = new Map(allEntries.map((entry) => [getEntrySlug(entry.id), entry]));
const countImages = (slug: string) => {
  const members = TRIP_CITIES[slug] ?? [slug];
  return members.reduce((sum, member) => {
    const entry = entryBySlug.get(member);
    return sum + (entry ? entry.data.images.length + 1 : 0);
  }, 0);
};

const categories = ['illustration', 'photography', 'design', 'ui-ux', 'other'] as const;
const categoryLabels: Record<string, string> = {
  illustration: '插画',
  photography: '摄影',
  design: '设计',
  'ui-ux': 'UI/UX',
  other: '其他',
};
const categoryCounts = Object.fromEntries(categories.map((cat) => [cat, 0])) as Record<string, number>;
for (const entry of entries) {
  categoryCounts[entry.data.category] = (categoryCounts[entry.data.category] ?? 0) + 1;
}

/* 时间轴：全年 12 个月刻度，side 决定卡片挂在轴线上下，
   同一侧相邻卡片至少隔开 3 个月，避免拥挤错位。 */
const MONTHS_IN_YEAR = 12;

const timeline = [
  {
    date: '1.20 — 1.23',
    title: '鄂赣行记',
    subtitle: '武汉 · 庐山 · 南昌',
    cover: '/assets/gallery/photography/wuhan.assets/yellow_crane_tower.jpg',
    href: `${base}gallery/hubei-jiangxi/`,
    gallerySlug: 'hubei-jiangxi',
    color: '#4a90d9',
    month: 1,
    cities: 3,
    side: 'above' as const,
  },
  {
    date: '2.25',
    title: '格尔木',
    subtitle: '察尔汗盐湖 · 昆仑山',
    cover: '/assets/gallery/photography/geermu.assets/qarhan_saltlake_1.jpg',
    href: `${base}gallery/photography/geermu/`,
    gallerySlug: 'geermu',
    color: '#2d7a5f',
    month: 2,
    cities: 1,
    side: 'below' as const,
  },
  {
    date: '4.4 — 4.8',
    title: '粤港澳三城游',
    subtitle: '广州 · 澳门 · 香港',
    cover: '/assets/gallery/photography/guangzhou.assets/Yat-sen_Mausoleum_front.JPG',
    href: `${base}gallery/bay-area/`,
    gallerySlug: 'greater-bay-area',
    color: '#1a5276',
    month: 4,
    cities: 3,
    side: 'above' as const,
  },
  {
    date: '5.3 — 5.6',
    title: '関西旅路',
    subtitle: '大阪 · 奈良 · 宇治 · 京都 · 神户 · 姬路',
    cover: '/assets/gallery/photography/osaka.assets/glico.jpg',
    href: `${base}gallery/japan/`,
    gallerySlug: 'japan',
    color: '#5a9e4b',
    month: 5,
    cities: 6,
    side: 'below' as const,
  },
  {
    date: '8.7 — 8.14',
    title: '山之东西',
    subtitle: '太原 · 大同 · 青岛 · 烟台',
    cover: '/assets/gallery/photography/summer-2026-four-cities.assets/qingdao_05.jpg',
    href: `${base}gallery/four-cities/`,
    gallerySlug: 'summer-2026-four-cities',
    color: '#96522c',
    month: 8,
    cities: 4,
    side: 'above' as const,
  },
].map((trip) => ({
  ...trip,
  images: countImages(trip.gallerySlug),
}));

/* 月份刻度的位置：落在每个月的中央 */
const monthPosition = (month: number) => ((month - 0.5) / MONTHS_IN_YEAR) * 100;
const tripMonths = new Set(timeline.map((trip) => trip.month));
const futureMonth = 10;
---

<BaseLayout
  title="画廊 | 6ch. · 林间笔记"
  description="6ch. 的作品集与视觉创作"
>
  <section class="container page-shell">
    <header class="page-header">
      <p class="section-kicker">Gallery</p>
      <h1>画廊</h1>
      <p class="section-lead">
        视觉创作的陈列室 — 插画、摄影、设计，每一幅都是林间的一扇窗。
      </p>
    </header>

    <!-- 2026 Journey Timeline -->
    <div class="trip-timeline">
      <h2 class="trip-timeline__heading">
        <span class="trip-timeline__heading-rule" aria-hidden="true"></span>
        2026 · 旅程时间线
        <span class="trip-timeline__heading-rule" aria-hidden="true"></span>
      </h2>

      <div class="trip-timeline__axis">
        <!-- Month labels -->
        <div class="trip-timeline__months">
          {
            Array.from({ length: MONTHS_IN_YEAR }, (_, i) => i + 1).map((m) => (
              <span class:list={['trip-timeline__month', { 'has-trip': tripMonths.has(m) }]}>
                {m}月
              </span>
            ))
          }
        </div>

        <!-- Axis line with ticks -->
        <div class="trip-timeline__track">
          <!-- 竖向参考网格，帮助读数 -->
          {
            Array.from({ length: MONTHS_IN_YEAR }, (_, i) => i + 1).map((m) => (
              <span
                class="trip-timeline__grid-line"
                aria-hidden="true"
                style={`left: ${monthPosition(m)}%`}
              />
            ))
          }

          {
            Array.from({ length: MONTHS_IN_YEAR }, (_, i) => i + 1).map((m) => (
              <span
                class="trip-timeline__tick"
                aria-hidden="true"
                style={`left: ${monthPosition(m)}%`}
              />
            ))
          }

          <!-- Trip nodes -->
          {
            timeline.map((trip, i) => (
              <a
                href={trip.href}
                class:list={[
                  'trip-timeline__node',
                  `trip-timeline__node--${trip.side}`,
                ]}
                data-trip-target={trip.gallerySlug}
                aria-label={`打开 ${trip.title}，${trip.cities} 城，${trip.images} 张照片`}
                style={`--trip-color: ${trip.color}; --trip-left: ${monthPosition(trip.month)}%`}
              >
                <div class="trip-timeline__stem" aria-hidden="true"></div>
                <div class="trip-timeline__dot" aria-hidden="true"></div>
                <div class="trip-timeline__card">
                  <div class="trip-timeline__card-img">
                    <GalleryImage
                      src={trip.cover}
                      alt={trip.title}
                      sizes="(max-width: 980px) calc(100vw - 3rem), 10.5rem"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      fetchpriority={i === 0 ? 'high' : 'auto'}
                    />
                    <time class="trip-timeline__date">{trip.date}</time>
                    <div class="trip-timeline__card-accent" style={`background: ${trip.color}`}></div>
                  </div>
                  <div class="trip-timeline__card-body">
                    <strong class="trip-timeline__title">{trip.title}</strong>
                    <span class="trip-timeline__sub">{trip.subtitle}</span>
                    <span class="trip-timeline__meta">
                      <span>{trip.cities} 城</span>
                      <span>{trip.images} 张</span>
                    </span>
                  </div>
                </div>
              </a>
            ))
          }

          <!-- 未完待续 marker -->
          <div
            class="trip-timeline__node--future"
            style={`--trip-left: ${monthPosition(futureMonth)}%`}
          >
            <div class="trip-timeline__dot trip-timeline__dot--ghost" aria-hidden="true"></div>
            <div class="trip-timeline__future-label">
              <span class="trip-timeline__future-icon">✦</span>
              未完待续
            </div>
          </div>
        </div>
      </div>
    </div>

    {
      entries.length > 0 ? (
        <>
          <div class="gallery-filters" role="group" aria-label="按分类筛选">
            <button
              type="button"
              class="gallery-filter"
              data-category=""
              aria-pressed="true"
            >
              <span>全部</span>
              <span class="gallery-filter__count">{entries.length}</span>
            </button>
            {
              categories.map((cat) => (
                <button
                  type="button"
                  class="gallery-filter"
                  data-category={cat}
                  aria-pressed="false"
                >
                  <span>{categoryLabels[cat]}</span>
                  <span class="gallery-filter__count">{categoryCounts[cat] ?? 0}</span>
                </button>
              ))
            }
          </div>

          <div class="gallery-grid">
            {
              entries.map((entry, i) => {
                const allImages = [entry.data.cover, ...entry.data.images];
                const slug = getEntrySlug(entry.id);
                return (
                  <GalleryCard
                    href={entryHref(entry.id)}
                    cover={entry.data.cover}
                    title={entry.data.title}
                    description={entry.data.description}
                    category={entry.data.category}
                    images={allImages}
                    imageDescs={[entry.data.coverDesc ?? '', ...(entry.data.imageDescs ?? [])]}
                    date={entry.data.date ? formatDate(entry.data.date) : undefined}
                    index={i}
                    slug={slug}
                  />
                );
              })
            }
          </div>

          <GalleryLightbox />
        </>
      ) : (
        <div class="gallery-empty card card--elevated">
          <p>
            画廊还在筹备中，作品即将上架。<br />
            林间正在生长，请稍后再来。
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  import { initGalleryFilters, initGalleryLightbox, initGalleryTimelineHighlights } from '../../scripts/gallery';
  initGalleryFilters();
  initGalleryLightbox();
  initGalleryTimelineHighlights();
</script>

<style>
  /* ---- Trip Timeline ---- */
  .trip-timeline {
    /* 卡片宽度按视口分档收缩，保证同侧卡片之间始终留有间距 */
    --trip-card: 10.5rem;
    --trip-card-half: calc(var(--trip-card) / 2);
    --trip-card-gap: 1.5rem;
    margin: 2.5rem 0 3.5rem;
  }

  @media (max-width: 1120px) {
    .trip-timeline {
      --trip-card: 8.75rem;
    }
  }

  .trip-timeline__heading {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--ch-display-font);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--ch-fg-muted);
    margin: 0 0 2.25rem;
  }

  .trip-timeline__heading-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--ch-border), transparent);
  }

  /* 左右留出半个卡片的余量，避免首末卡片溢出容器 */
  .trip-timeline__axis {
    padding-inline: var(--trip-card-half);
  }

  /* Month labels */
  .trip-timeline__months {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    margin-bottom: 0.5rem;
  }

  .trip-timeline__month {
    text-align: center;
    font-family: var(--ch-mono-font);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--ch-fg-muted);
    opacity: 0.35;
  }

  .trip-timeline__month.has-trip {
    opacity: 0.8;
  }

  /* Track: 12 个月刻度。轴线穿过垂直中点，节点按月份百分比定位 */
  .trip-timeline__track {
    position: relative;
    min-height: 27rem;
  }

  /* Horizontal axis line，两端渐隐 */
  .trip-timeline__track::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      var(--ch-border) 6%,
      var(--ch-border) 94%,
      transparent
    );
    transform: translateY(-0.5px);
  }

  /* 竖向参考网格 */
  .trip-timeline__grid-line {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--ch-border-soft);
    transform: translateX(-50%);
    opacity: 0.55;
    pointer-events: none;
  }

  /* Tick marks at each month position */
  .trip-timeline__tick {
    position: absolute;
    top: 50%;
    width: 1px;
    height: 7px;
    background: var(--ch-border);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .trip-timeline__node {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--trip-left);
    width: var(--trip-card);
    text-decoration: none;
    color: inherit;
    z-index: 1;
    transform: translateX(-50%);
    transition: transform 0.3s ease;
  }

  .trip-timeline__node:hover,
  .trip-timeline__node:focus-visible,
  .trip-timeline__node.is-linked {
    transform: translate(-50%, -3px);
  }

  .trip-timeline__node--below:hover,
  .trip-timeline__node--below:focus-visible,
  .trip-timeline__node--below.is-linked {
    transform: translate(-50%, 3px);
  }

  .trip-timeline__node:focus-visible {
    outline: none;
  }

  .trip-timeline__node:focus-visible .trip-timeline__card {
    box-shadow:
      0 0 0 2px color-mix(in srgb, var(--trip-color) 42%, transparent),
      0 6px 24px color-mix(in srgb, var(--trip-color) 18%, transparent);
  }

  /* Dot: absolute at axis center */
  .trip-timeline__dot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--trip-color);
    border: 2px solid var(--ch-surface-solid);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--trip-color) 35%, transparent);
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  /* Stem: absolute, from dot to card */
  .trip-timeline__stem {
    position: absolute;
    left: 50%;
    width: 1px;
    background: var(--trip-color);
    opacity: 0.35;
    z-index: 0;
  }

  .trip-timeline__node--above .trip-timeline__stem {
    top: calc(50% - var(--trip-card-gap));
    height: var(--trip-card-gap);
    transform: translateY(-100%);
  }

  .trip-timeline__node--below .trip-timeline__stem {
    top: 50%;
    height: var(--trip-card-gap);
  }

  .trip-timeline__node--above .trip-timeline__card {
    bottom: calc(50% + var(--trip-card-gap));
  }

  .trip-timeline__node--below .trip-timeline__card {
    top: calc(50% + var(--trip-card-gap));
  }

  /* Trip card */
  .trip-timeline__card {
    position: absolute;
    left: 50%;
    z-index: 1;
    width: 100%;
    background: var(--ch-glass-bg);
    border: 1px solid var(--ch-glass-border);
    border-radius: var(--ch-radius-sm);
    overflow: hidden;
    backdrop-filter: blur(var(--ch-glass-blur));
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
    transform: translateX(-50%);
  }

  .trip-timeline__node:hover .trip-timeline__card,
  .trip-timeline__node.is-linked .trip-timeline__card {
    border-color: color-mix(in srgb, var(--trip-color) 55%, transparent);
    box-shadow: 0 10px 30px -12px color-mix(in srgb, var(--trip-color) 32%, transparent);
  }

  .trip-timeline__card-img {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    position: relative;
  }

  .trip-timeline__card-img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .trip-timeline__node:hover .trip-timeline__card-img img,
  .trip-timeline__node.is-linked .trip-timeline__card-img img {
    transform: scale(1.06);
  }

  /* 日期压在图上，省出卡片正文的高度 */
  .trip-timeline__date {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.1rem 0.5rem 0.35rem;
    background: linear-gradient(to top, rgba(8, 20, 13, 0.72), transparent);
    font-family: var(--ch-mono-font);
    font-size: 0.56rem;
    letter-spacing: 0.09em;
    color: #f2f8ef;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
  }

  .trip-timeline__card-accent {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
  }

  .trip-timeline__card-body {
    padding: 0.55rem 0.7rem 0.65rem;
  }

  .trip-timeline__title {
    display: block;
    font-family: var(--ch-display-font);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 0.12rem;
  }

  .trip-timeline__sub {
    display: block;
    font-size: 0.62rem;
    color: var(--ch-fg-muted);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .trip-timeline__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.45rem;
    font-family: var(--ch-mono-font);
    font-size: 0.54rem;
    color: var(--ch-fg-muted);
  }

  .trip-timeline__meta span {
    display: inline-flex;
    align-items: center;
    min-height: 1.2rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--trip-color) 9%, var(--ch-surface-solid));
    border: 1px solid color-mix(in srgb, var(--trip-color) 16%, var(--ch-glass-border));
  }

  /* ---- 未完待续 ---- */
  .trip-timeline__node--future {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--trip-left);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: inherit;
    z-index: 1;
    transform: translateX(-50%);
  }

  .trip-timeline__dot--ghost {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: transparent;
    border: 2px dashed var(--ch-border);
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .trip-timeline__future-label {
    position: relative;
    z-index: 1;
    margin-top: 1.4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    font-family: var(--ch-display-font);
    font-size: 0.78rem;
    color: var(--ch-fg-muted);
    letter-spacing: 0.08em;
    opacity: 0.7;
    white-space: nowrap;
  }

  .trip-timeline__future-icon {
    font-size: 0.85rem;
    opacity: 0.5;
  }

  /* 12 个月刻度需要更多横向空间，低于此宽度改为纵向列表 */
  @media (max-width: 980px) {
    .trip-timeline__axis {
      padding-inline: 0;
    }

    .trip-timeline__track {
      display: flex;
      flex-direction: column;
      min-height: auto;
      padding: 0.5rem 0;
    }

    .trip-timeline__track::before {
      left: 0.55rem;
      right: auto;
      top: 0.5rem;
      bottom: 0.5rem;
      width: 1px;
      height: auto;
      background: var(--ch-border);
      transform: none;
    }

    .trip-timeline__months {
      display: none;
    }

    .trip-timeline__grid-line {
      display: none;
    }

    .trip-timeline__node,
    .trip-timeline__node--above,
    .trip-timeline__node--below {
      position: relative;
      top: auto;
      bottom: auto;
      left: auto;
      width: 100%;
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 0.85rem;
      padding: 0.5rem 0 0.5rem 1.6rem;
      transform: none;
    }

    .trip-timeline__node:hover,
    .trip-timeline__node:focus-visible,
    .trip-timeline__node.is-linked,
    .trip-timeline__node--below:hover,
    .trip-timeline__node--below:focus-visible,
    .trip-timeline__node--below.is-linked {
      transform: none;
    }

    .trip-timeline__dot,
    .trip-timeline__node--above .trip-timeline__dot,
    .trip-timeline__node--below .trip-timeline__dot {
      position: absolute;
      left: 0.25rem;
      top: 1.05rem;
      transform: none;
    }

    .trip-timeline__stem {
      display: none;
    }

    .trip-timeline__card {
      position: relative;
      top: auto;
      bottom: auto;
      left: auto;
      width: 100%;
      max-width: 100%;
      margin: 0;
      transform: none;
    }

    .trip-timeline__card-img {
      aspect-ratio: 16 / 9;
    }

