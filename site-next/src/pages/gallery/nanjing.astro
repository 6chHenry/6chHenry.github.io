---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryLightbox from '../../components/GalleryLightbox.astro';
import GalleryImage from '../../components/GalleryImage.astro';
import { resolveGalleryImages } from '../../utils/gallery-images';
import { mergeChapters } from '../../data/gallery-trips';
import GalleryNextTrip from '../../components/GalleryNextTrip.astro';

const base = import.meta.env.BASE_URL;

const entries = await getCollection('gallery', ({ data }) => !data.draft);
const entry = entries.find((e) => e.id.replace(/\.md$/, '') === 'photography/nanjing');
if (!entry) throw new Error('Missing gallery entry: photography/nanjing');

/* 章节元数据（展示层）：三天即三章，顺序即时间线（城内 → 钟山 → 牛首山） */
const chapterMeta = [
  {
    key: 'day1',
    title: '城内',
    en: 'The Old City',
    accent: '#955639',
    span: '10.03 · 周五',
    stops: ['东南大学', '玄武门', '先锋书店', '长江大桥', '南京博物院'],
    desc: '第一天先不赶路，在城里把自己安顿好：东南大学的红灯笼、玄武门内的水色、先锋书店爬满绿植的门脸；傍晚的长江大桥把钢铁骨骼沉进暮色，夜里由大殿的金色琉璃开个头。',
  },
  {
    key: 'day2',
    title: '钟山',
    en: 'Zhongshan',
    accent: '#3f7057',
    span: '10.04 · 周六',
    stops: ['明孝陵', '陵园路', '中山陵', '碑亭'],
    desc: '第二天交给紫金山。明孝陵的檐角在留白的天空下摆出六百年的蓝与红，陵园路的梧桐在头顶合拢成隧道，人潮一路漫上山坡，红旗在绿意里扬起来。392 级台阶走完，整座南京城就躺在中轴线的尽头。',
  },
  {
    key: 'day3',
    title: '牛首山',
    en: 'Niushou Mountain',
    accent: '#a8842c',
    span: '10.05 · 周日',
    stops: ['放生池', '禅林路', '佛顶塔', '佛顶宫'],
    desc: '最后一天整日在牛首山。上午，放生池把塔与山影稳稳收进水里，禅林路的小沙弥一个比一个入定；午后走进佛顶宫——鎏金穹顶从山坳里升起来，卧佛与曼陀罗把这趟旅程的喧闹都轻轻放下。',
  },
] as const;

/* 照片流：封面单独做 hero，不进章节网格；章节从第一张 images 开始 */
const sources = [entry.data.cover, ...entry.data.images];
const descs = [entry.data.coverDesc ?? '', ...(entry.data.imageDescs ?? [])];
const keys = [entry.data.coverChapter ?? '', ...(entry.data.imageChapters ?? [])];
const assets = resolveGalleryImages(sources, base);

type Photo = {
  asset: (typeof assets)[number];
  desc: string;
  alt: string;
  index: number;
};

const byChapter = new Map<string, Photo[]>();
sources.slice(1).forEach((_, k) => {
  const i = k + 1; // 在完整照片流（含封面）中的下标，供灯箱定位
  const key = keys[i] || 'other';
  const chapter = chapterMeta.find((c) => c.key === key);
  const name = chapter?.title ?? '沿途';
  const photo: Photo = {
    asset: assets[i],
    desc: descs[i] ?? '',
    alt: `${name}：${descs[i] ?? ''}`.slice(0, 80) || name,
    index: i,
  };
  const list = byChapter.get(key);
  if (list) list.push(photo);
  else byChapter.set(key, [photo]);
});

const chapters = chapterMeta
  .map((meta) => ({ ...meta, photos: byChapter.get(meta.key) ?? [] }))
  .filter((c) => c.photos.length > 0);

const totalPhotos = sources.length;
const totalStops = chapterMeta.reduce((sum, c) => sum + c.stops.length, 0);
const tripAccent = '#a8842c';
const dateLabel = entry.data.date
  ? new Date(entry.data.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';

const lightboxMeta = JSON.stringify({
  images: assets,
  imageDescs: descs,
  chapters: mergeChapters([entry.data.coverChapter ?? '', ...(entry.data.imageChapters ?? [])]),
  title: entry.data.title,
  description: entry.data.description ?? '',
  category: 'photography',
  date: dateLabel,
  detailUrl: `${base}gallery/photography/nanjing/`,
});

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  title={`${entry.data.title} · 南京 | 6ch.`}
  description={entry.data.description ?? '金陵三日——2026 国庆，三天南京：钟山、牛首山与城内。'}
>
  <section class="container page-shell nj" style={`--trip-accent: ${tripAccent}`}>
    <a class="nj-back" href={`${base}gallery/`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6" />
      </svg>
      返回画廊
    </a>

    <header class="nj-hero">
      <p class="nj-hero__kicker">Nanjing · 2026.10.03 — 10.05 · 国庆</p>
      <h1 class="nj-hero__title">金陵三日</h1>
      <p class="nj-hero__en">Three Days in Jinling</p>
      <p class="nj-hero__lead">
        三天，一座金陵。第一天在城内落脚，书页、城砖与江风都在步行可达的地方；
        第二天上钟山，钻过梧桐隧道，走完 392 级台阶；最后一天交给牛首山的鎏金穹顶。
        一半是山水与古意，一半是人间。
      </p>
      <dl class="nj-hero__stats">
        <div class="nj-stat">
          <dt>天数</dt>
          <dd>{chapters.length}</dd>
        </div>
        <div class="nj-stat">
          <dt>照片</dt>
          <dd>{totalPhotos}</dd>
        </div>
        <div class="nj-stat">
          <dt>停留</dt>
          <dd>{totalStops}</dd>
        </div>
        <div class="nj-stat">
          <dt>时节</dt>
          <dd>国庆</dd>
        </div>
      </dl>
    </header>

    <figure class="nj-poem" aria-label="藏头诗：四句首字连读为金陵三日">
      <div class="nj-poem__lines">
        <p class="nj-poem__line" style={`--line-accent: #955639`}><b>金</b>风城郭大桥头，</p>
        <p class="nj-poem__line" style={`--line-accent: #3f7057`}><b>陵</b>上梧桐石道幽。</p>
        <p class="nj-poem__line" style={`--line-accent: #3f7057`}><b>三</b>百级台登未尽，</p>
        <p class="nj-poem__line" style={`--line-accent: #a8842c`}><b>日</b>边佛顶鎏金收。</p>
      </div>
    </figure>

    <figure class="nj-cover">
      <button
        type="button"
        class="nj-cover__btn"
        data-gallery-meta={lightboxMeta}
        data-gallery-index={0}
        aria-label={`放大封面：${descs[0]}`}
      >
        <GalleryImage
          asset={assets[0]}
          alt={descs[0] || entry.data.title}
          sizes="(max-width: 900px) 100vw, 74rem"
          loading="eager"
          fetchpriority="high"
        />
        <span class="nj-cover__scrim" aria-hidden="true"></span>
        <span class="nj-cover__zoom" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <circle cx="11" cy="11" r="7" />
            <line x1="16.5" y1="16.5" x2="21" y2="21" />
            <line x1="11" y1="8" x2="11" y2="14" />
            <line x1="8" y1="11" x2="14" y2="11" />
          </svg>
        </span>
      </button>
      <figcaption class="nj-cover__cap">
        <span class="nj-cover__cap-num">封面 · Day 3</span>
        {descs[0]}
      </figcaption>
    </figure>

    <nav class="nj-route" aria-label="行程时间线">
      <span class="nj-route__label">时间线</span>
      <div class="nj-route__list">
        {
          chapters.map((chapter, i) => (
            <>
              {i > 0 && <span class="nj-route__link-line" aria-hidden="true" />}
              <a
                class:list={['nj-route__stop', { 'is-active': i === 0 }]}
                href={`#nj-${chapter.key}`}
                data-route-target={`nj-${chapter.key}`}
                style={`--stop-accent: ${chapter.accent}`}
              >
                <span class="nj-route__dot" aria-hidden="true" />
                <span class="nj-route__text">
                  <span class="nj-route__name">{chapter.title}</span>
                  <span class="nj-route__span">{chapter.span}</span>
                </span>
              </a>
            </>
          ))
        }
      </div>
    </nav>

    {
      chapters.map((chapter, ci) => (
        <section
          id={`nj-${chapter.key}`}
          class="nj-chapter"
          style={`--chapter-accent: ${chapter.accent}`}
          data-chapter={chapter.key}
        >
          <header class="nj-chapter__header">
            <span class="nj-chapter__index">DAY {pad(ci + 1)}</span>
            <div class="nj-chapter__names">
              <h2 class="nj-chapter__title">{chapter.title}</h2>
              <span class="nj-chapter__en">{chapter.en}</span>
            </div>
            <span class="nj-chapter__span">{chapter.span}</span>
          </header>

          <div class="nj-chapter__route" aria-label="当日路线">
            {chapter.stops.map((stop, i) => (
              <>
                {i > 0 && <span class="nj-chapter__route-arrow" aria-hidden="true">→</span>}
                <span class="nj-chapter__route-stop">{stop}</span>
              </>
            ))}
          </div>

          <p class="nj-chapter__desc">{chapter.desc}</p>

          <div class="nj-chapter__grid">
            {
              chapter.photos.map((photo) => (
                <figure class="nj-photo">
                  <button
                    type="button"
                    class="nj-photo__btn"
                    data-gallery-meta={lightboxMeta}
                    data-gallery-index={photo.index}
                    aria-label={`放大第 ${pad(photo.index + 1)} 张：${photo.desc}`}
                  >
                    <GalleryImage
                      asset={photo.asset}
                      alt={photo.desc || chapter.title}
                      sizes="(max-width: 620px) 100vw, (max-width: 1000px) 50vw, 33vw"
                      loading="lazy"
                    />
                    <span class="nj-photo__num" aria-hidden="true">{pad(photo.index + 1)}</span>
                  </button>
                  <figcaption class="nj-photo__cap">
                    <span class="nj-photo__cap-num">{pad(photo.index + 1)}</span>
                    <span class="nj-photo__cap-text">{photo.desc}</span>
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </section>
      ))
    }

    <footer class="nj-foot">
      <p class="nj-foot__line">
        <a href={`${base}gallery/`}>回到画廊</a>
      </p>
    </footer>

    <GalleryNextTrip slug="nanjing" />
  </section>

  <GalleryLightbox />
</BaseLayout>

<script>
  import { initGalleryLightbox } from '../../scripts/gallery';

  initGalleryLightbox();

  /* 章节进场：确定性滚动检测（比 IntersectionObserver 更稳，
     快速滚动也不会漏帧；脚本失效时 is-armed 不会被加上，照片照常显示） */
  const grids = document.querySelectorAll<HTMLElement>('.nj-chapter__grid');
  grids.forEach((grid) => grid.classList.add('is-armed'));

  const figures: HTMLElement[] = [];
  grids.forEach((grid) => {
    Array.from(grid.children).forEach((child, i) => {
      const el = child as HTMLElement;
      el.dataset.revealDelay = String(Math.min(i, 3) * 70);
      figures.push(el);
    });
  });

  let ticking = false;
  const reveal = () => {
    ticking = false;
    const limit = window.innerHeight * 1.1;
    for (const fig of figures) {
      if (fig.classList.contains('is-visible')) continue;
      if (fig.getBoundingClientRect().top < limit) {
        const delay = Number(fig.dataset.revealDelay ?? 0);
        window.setTimeout(() => fig.classList.add('is-visible'), delay);
      }
    }
  };

  const requestReveal = () => {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(reveal);
  };

  window.addEventListener('scroll', requestReveal, { passive: true });
  window.addEventListener('resize', requestReveal, { passive: true });
  reveal();

  /* 时间线导航跟随滚动高亮 */
  const stops = Array.from(document.querySelectorAll<HTMLElement>('.nj-route__stop'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.nj-chapter'));

  const setActive = (key: string) => {
    stops.forEach((stop) => stop.classList.toggle('is-active', stop.dataset.routeTarget === `nj-${key}`));
  };

  if (sections.length > 0 && 'IntersectionObserver' in window) {
    const spy = new IntersectionObserver(
      (records) => {
        const visible = records
          .filter((r) => r.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) setActive((visible.target as HTMLElement).dataset.chapter ?? '');
      },
      { rootMargin: '-30% 0px -55% 0px', threshold: [0, 0.25, 0.5] },
    );
    sections.forEach((section) => spy.observe(section));
  }

  /* 点击时间线导航时，补偿 sticky 导航与页头的高度 */
  stops.forEach((stop) => {
    stop.addEventListener('click', (event) => {
      const id = stop.dataset.routeTarget;
      if (!id) return;
      const target = document.getElementById(id);
      if (!target) return;
      event.preventDefault();
      const nav = document.querySelector<HTMLElement>('.nj-route');
      const offset = (nav?.offsetHeight ?? 0) + 96;
      const top = target.getBoundingClientRect().top + window.scrollY - offset;
      window.scrollTo({ top, behavior: 'smooth' });
      history.replaceState(null, '', `#${id}`);
    });
  });
</script>

<style>
  .nj {
    --nj-rule: color-mix(in srgb, var(--ch-border) 70%, transparent);
  }

  /* ---- 返回 ---- */
  .nj-back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1.75rem;
    font-family: var(--ch-academic-font);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--ch-fg-muted);
    text-decoration: none;
    transition: color var(--ch-transition);
  }

  .nj-back svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .nj-back:hover {
    color: var(--ch-accent);
  }

  /* ---- Hero ---- */
  .nj-hero {
    max-width: 44rem;
    margin: 0 0 2.75rem;
  }

  .nj-hero__kicker {
    margin: 0 0 1.1rem;
    font-family: var(--ch-mono-font);
    font-size: 0.63rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--trip-accent);
    opacity: 0.85;
  }

  .nj-hero__title {
    margin: 0;
    font-family: var(--ch-display-font);
    font-size: clamp(2.6rem, 6vw, 4rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: 0.04em;
  }

  .nj-hero__en {
    margin: 0.5rem 0 0;
    font-family: var(--ch-display-font);
    font-size: 1rem;
    font-style: italic;
    letter-spacing: 0.08em;
    color: var(--ch-fg-muted);
    opacity: 0.75;
  }

  .nj-hero__lead {
    margin: 1.5rem 0 0;
    font-size: 0.96rem;
    line-height: 2;
    color: var(--ch-fg-muted);
  }

  .nj-hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 2rem 0 0;
    border-top: 1px solid var(--nj-rule);
  }

  .nj-stat {
    flex: 1 1 6rem;
    padding: 0.9rem 1rem 0.9rem 0;
  }

  .nj-stat + .nj-stat {
    padding-left: 1rem;
    border-left: 1px solid var(--nj-rule);
  }

  .nj-stat dt {
    font-family: var(--ch-mono-font);
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ch-fg-muted);
    opacity: 0.7;
  }

  .nj-stat dd {
    margin: 0.3rem 0 0;
    font-family: var(--ch-display-font);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* ---- 藏头诗 ---- */
  .nj-poem {
    max-width: 26rem;
    margin: 0 auto 2.75rem;
    padding: 1.75rem 1rem 1.4rem;
    border-top: 1px solid var(--nj-rule);
    border-bottom: 1px solid var(--nj-rule);
    text-align: center;
  }

  .nj-poem__line {
    margin: 0;
    font-family: var(--ch-display-font);
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    line-height: 2.15;
    color: var(--ch-fg);
  }

  .nj-poem__line b {
    font-weight: 700;
    color: var(--line-accent);
  }

  /* ---- 封面 ---- */
  .nj-cover {
    margin: 0 0 2.5rem;
  }

  .nj-cover__btn {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--ch-radius);
    overflow: hidden;
    background: var(--ch-surface-elevated);
    cursor: zoom-in;
    box-shadow: var(--ch-shadow);
  }

  .nj-cover__btn img {
    display: block;
    width: 100%;
    height: clamp(15rem, 42vw, 30rem);
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nj-cover__btn:hover img {
    transform: scale(1.03);
  }

  .nj-cover__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 24, 16, 0.32), transparent 46%);
    opacity: 0.9;
    pointer-events: none;
  }

  .nj-cover__zoom {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: #f5fbf3;
    background: rgba(14, 30, 20, 0.42);
    backdrop-filter: blur(6px);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity var(--ch-transition), transform var(--ch-transition);
    pointer-events: none;
  }

  .nj-cover__zoom svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .nj-cover__btn:hover .nj-cover__zoom,
  .nj-cover__btn:focus-visible .nj-cover__zoom {
    opacity: 1;
    transform: translateY(0);
  }

  .nj-cover__cap {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-top: 0.9rem;
    font-size: 0.82rem;
    line-height: 1.8;
    color: var(--ch-fg-muted);
  }

  .nj-cover__cap-num {
    flex: none;
    font-family: var(--ch-mono-font);
    font-size: 0.56rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--trip-accent);
    padding: 0.1rem 0.45rem;
    border: 1px solid color-mix(in srgb, var(--trip-accent) 30%, transparent);
    border-radius: 999px;
  }

  /* ---- 时间线导航 ---- */
  .nj-route {
    position: sticky;
    top: calc(var(--ch-header-height) + 0.5rem);
    z-index: 6;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    margin: 0 0 3rem;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--ch-glass-border);
    border-radius: 999px;
    background: var(--ch-glass-bg);
    backdrop-filter: blur(var(--ch-glass-blur));
    box-shadow: 0 6px 24px -18px rgba(20, 36, 26, 0.5);
  }

  .nj-route__label {
    position: absolute;
    left: 1.1rem;
    flex: none;
    font-family: var(--ch-mono-font);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ch-fg-muted);
    opacity: 0.6;
  }

  .nj-route__list {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nj-route__list::-webkit-scrollbar {
    display: none;
  }

  .nj-route__link-line {
    flex: none;
    width: 1.15rem;
    height: 1px;
    margin: 0 0.35rem;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--ch-fg-muted) 30%, transparent),
      color-mix(in srgb, var(--ch-fg-muted) 12%, transparent)
    );
  }

  .nj-route__stop {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex: none;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    text-decoration: none;
    color: var(--ch-fg-muted);
    transition: background var(--ch-transition), color var(--ch-transition);
  }

  .nj-route__dot {
    width: 0.4rem;
    height: 0.4rem;
    flex: none;
    border-radius: 50%;
    background: var(--stop-accent);
    opacity: 0.4;
    transition: opacity var(--ch-transition), box-shadow var(--ch-transition);
  }

  .nj-route__text {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    min-width: 0;
  }

  .nj-route__name {
    font-family: var(--ch-display-font);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .nj-route__span {
    font-family: var(--ch-mono-font);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    opacity: 0.62;
    white-space: nowrap;
  }

