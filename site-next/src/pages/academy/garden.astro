---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

/* 与正式版同一份事实，换一种讲法 */
const roots = [
  { title: 'School of Artificial Intelligence, SJTU', date: 'Apr. 2025 -- Present', note: '本科转入人工智能学院' },
  { title: 'Zhiyuan Honor Program, SJTU', date: 'Feb. 2025 -- Present', note: '致远荣誉计划' },
];

const branches = [
  {
    title: 'Computer Vision',
    body: '喜欢计算机视觉，因为它让机器第一次「看见」图像和视频。',
  },
  {
    title: 'Embodied AI',
    body: '也想为机器人造一颗会感知的小脑。',
  },
];

const leaves = [
  { title: 'LLM Acceleration', period: '2026 春' },
  { title: '语音变声变速', period: '2025 秋' },
  { title: '自动驾驶行为仿真', period: '2025 夏' },
];

const buds = [
  { title: '论文 · Publications', body: '花期未至——有些花还在酝酿，等一场春天。' },
  { title: '经历 · Experience', body: '根还在往深处走，先不急着开花。' },
  { title: '风闻 · Media', body: '风还没有把消息吹到这片林子里。' },
];

const rings = [
  '2026 · 美赛 H 奖',
  '2025 · 本科生国家奖学金',
  '2025 · 致远荣誉奖学金',
  '2025 · 本科生 C 等奖学金',
  '2025 · 全国大学生数学建模竞赛全国二等奖',
];

const sprouts = [
  { date: '04/2025', body: 'I was admitted to SAI.' },
  { date: '03/2025', body: 'I became a member of A+ Club of SJTU ME.' },
  { date: '02/2025', body: 'I became a member of Zhiyuan Honor Program, SJTU.' },
  { date: '09/2024', body: 'Excited to start my ME B.Eng. at SJTU ME.' },
];

/* ── 生长之树：确定性伪随机，构建期生成枝叶，每次构建形态一致 ── */
function mulberry32(seed: number): () => number {
  return function () {
    let t = (seed += 0x6d2b79f5);
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(20260422);

interface FoliageDot {
  cx: number;
  cy: number;
  r: number;
  o: number;
  fill: string;
}

const foliageAnchors: Array<[number, number, number]> = [
  [292, 186, 1],
  [322, 208, 0.85],
  [458, 196, 0.95],
  [430, 178, 0.9],
  [388, 102, 0.85],
  [360, 150, 1],
  [408, 148, 0.9],
];
const crownTones = ['var(--gt-crown)', 'var(--gt-crown-soft)', 'var(--gt-crown-deep)'];
const foliage: FoliageDot[] = [];
for (const [ax, ay, scale] of foliageAnchors) {
  const count = 12 + Math.floor(rnd() * 4);
  for (let i = 0; i < count; i += 1) {
    const angle = rnd() * Math.PI * 2;
    const dist = (14 + rnd() * 40) * scale;
    foliage.push({
      cx: Math.round((ax + Math.cos(angle) * dist * 1.3) * 10) / 10,
      cy: Math.round((ay + Math.sin(angle) * dist * 0.74 - 6) * 10) / 10,
      r: Math.round((2.6 + rnd() * 5.4) * 10) / 10,
      o: Math.round((0.28 + rnd() * 0.4) * 100) / 100,
      fill: crownTones[Math.floor(rnd() * crownTones.length)],
    });
  }
}
foliage.sort((a, b) => a.cy - b.cy);

const fallingLeaves = [
  { x: 496, y: 236, rot: 24, s: 1 },
  { x: 272, y: 258, rot: -30, s: 0.85 },
];

interface Callout {
  id: string;
  ax: number; // 锚点（树上）
  ay: number;
  lx: number; // 文字端
  ly: number;
  anchor: 'start' | 'end';
}

const callouts: Callout[] = [
  { id: 'g-news', ax: 196, ay: 80, lx: 100, ly: 54, anchor: 'end' },
  { id: 'g-trunk', ax: 378, ay: 290, lx: 96, ly: 300, anchor: 'end' },
  { id: 'g-leaf', ax: 452, ay: 196, lx: 652, ly: 150, anchor: 'start' },
  { id: 'g-flower', ax: 398, ay: 92, lx: 606, ly: 72, anchor: 'start' },
  { id: 'g-ring', ax: 406, ay: 394, lx: 640, ly: 424, anchor: 'start' },
  { id: 'g-root', ax: 372, ay: 430, lx: 100, ly: 464, anchor: 'end' },
];

const calloutTexts: Record<string, string> = {
  'g-news': '抽芽 · 动态',
  'g-trunk': '枝干 · 方向',
  'g-leaf': '叶片 · 项目',
  'g-flower': '花苞 · 论文',
  'g-ring': '年轮 · 荣誉',
  'g-root': '根系 · 教育',
};
---

<BaseLayout title="学术花园 | KeWei Liu" description="KeWei Liu 学术主页的林间读法——同一份履历，长成一棵树。">
  <section class="container page-shell garden-page">
    <header class="page-header">
      <p class="section-kicker">Academy Garden</p>
      <h1>学术花园</h1>
      <p class="section-lead">
        这里是学术主页的林间读法：同一份履历，长成一棵树——根是来处，干是方向，
        叶是做过的事，花苞还没开，年轮一圈圈记着认真。想看正式版本，请去<a href={`${base}academy/`}>学术主页</a>。
      </p>
      <div class="garden-actions">
        <a class="pill" href={`${base}academy/`}>正式版</a>
        <a class="pill pill--glass" href={`${base}about/`}>关于我</a>
      </div>
    </header>

    {/* ── 生长之树导览图 ── */}
    <div class="tree-wrap">
      <svg class="grow-tree" viewBox="0 0 760 540" role="group" aria-label="生长之树导览图：点击各部位跳转到对应小节">
        {/* 天空与光 */}
        <defs>
          <radialGradient id="gt-sun-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="var(--gt-sun)" stop-opacity=".34" />
            <stop offset="100%" stop-color="var(--gt-sun)" stop-opacity="0" />
          </radialGradient>
        </defs>
        <circle cx="664" cy="58" r="38" fill="url(#gt-sun-glow)" />
        <circle cx="664" cy="58" r="13" fill="var(--gt-sun)" />
        <g class="gt-birds" stroke="var(--gt-bird)" stroke-width="1.6" fill="none" stroke-linecap="round">
          <path d="M196 74 q7 -6 13 0 M208 73 q7 -6 13 0" />
          <path d="M246 94 q6 -5 11 0 M256 93 q6 -5 11 0" />
        </g>

        {/* 地面 */}
        <ellipse cx="380" cy="398" rx="96" ry="7" fill="var(--ch-fg)" opacity="0.05" />
        <path d="M56 392 H704" stroke="var(--gt-ground)" stroke-width="2.6" stroke-linecap="round" />
        <g stroke="var(--gt-grass)" stroke-width="1.4" stroke-linecap="round">
          <path d="M120 390 q1 -9 -3 -13" />
          <path d="M212 390 q-1 -8 3 -12" />
          <path d="M300 390 q1 -10 -2 -15" />
          <path d="M488 390 q-1 -9 3 -13" />
          <path d="M600 390 q1 -8 -2 -12" />
          <path d="M672 390 q-1 -9 2 -13" />
        </g>

        {/* 根系（土面以下，细而克制） */}
        <g class="gt-roots" stroke="var(--gt-root)" fill="none" stroke-linecap="round">
          <path d="M372 396 C364 420 350 436 330 450" stroke-width="2.6" />
          <path d="M380 396 C382 424 380 444 374 462" stroke-width="2.2" />
          <path d="M386 396 C396 418 410 432 428 444" stroke-width="2.4" />
          <path d="M366 408 q-16 -2 -28 4 M388 418 q14 -4 26 0" stroke-width="1.4" />
        </g>

        {/* 树干与枝桠：渐细的笔墨线条 */}
        <g stroke="var(--gt-trunk)" fill="none" stroke-linecap="round">
          <path d="M380 392 C376 340 374 300 377 258 C379 226 383 196 391 166" stroke-width="7" />
          <path d="M378 264 C362 250 344 238 326 224 C312 213 298 202 288 194" stroke-width="4.6" />
          <path d="M300 218 C291 207 285 196 281 183" stroke-width="2.6" />
          <path d="M379 252 C399 242 421 231 443 217 C451 212 458 207 464 203" stroke-width="4.4" />
          <path d="M431 220 C441 209 447 197 450 185" stroke-width="2.5" />
          <path d="M383 196 C385 168 390 142 397 118" stroke-width="3.2" />
        </g>

        {/* 树冠底雾：几团极淡的体量 */}
        <g>
          <circle cx="296" cy="190" r="30" fill="var(--gt-crown)" opacity="0.35" />
          <circle cx="456" cy="194" r="28" fill="var(--gt-crown)" opacity="0.32" />
          <circle cx="386" cy="108" r="24" fill="var(--gt-crown)" opacity="0.3" />
          <circle cx="368" cy="158" r="36" fill="var(--gt-crown-deep)" opacity="0.22" />
          <circle cx="428" cy="164" r="27" fill="var(--gt-crown-deep)" opacity="0.18" />
        </g>

        {/* 叶点：层层叠出蓬松的冠 */}
        {
          foliage.map((dot) => (
            <circle cx={dot.cx} cy={dot.cy} r={dot.r} fill={dot.fill} opacity={dot.o} />
          ))
        }

        {/* 飘落的叶子 */}
        {
          fallingLeaves.map((leaf) => (
            <path
              transform={`translate(${leaf.x} ${leaf.y}) rotate(${leaf.rot}) scale(${leaf.s})`}
              d="M0 0 C4 -3 8 -3 11 0 C8 4 4 4 0 0 Z"
              fill="var(--gt-crown-deep)"
              opacity="0.55"
            />
          ))
        }

        {/* 花苞（论文）：金点带光晕 */}
        <g>
          <circle cx="322" cy="122" r="9" fill="var(--gt-bud)" opacity="0.22" />
          <circle cx="322" cy="122" r="3.4" fill="var(--gt-bud)" />
          <circle cx="470" cy="152" r="8" fill="var(--gt-bud)" opacity="0.2" />
          <circle cx="470" cy="152" r="3" fill="var(--gt-bud)" />
          <circle cx="398" cy="88" r="8.4" fill="var(--gt-bud)" opacity="0.22" />
          <circle cx="398" cy="88" r="3.2" fill="var(--gt-bud)" />
          <circle cx="512" cy="178" r="7.4" fill="var(--gt-bud)" opacity="0.18" />
          <circle cx="512" cy="178" r="2.8" fill="var(--gt-bud)" />
        </g>

        {/* 年轮（荣誉） */}
        <g stroke="var(--gt-ring)" fill="none">
          <ellipse cx="380" cy="394" rx="20" ry="7" stroke-width="1.3" />
          <ellipse cx="380" cy="394" rx="33" ry="11.5" stroke-width="1.2" opacity="0.7" />
          <ellipse cx="380" cy="394" rx="46" ry="16" stroke-width="1.1" opacity="0.45" />
        </g>

        {/* 图注标签：引线 + 端点，图鉴式标注 */}
        {
          callouts.map((callout) => (
            <a class="gt-label" href={`#${callout.id}`}>
              <g>
                <circle class="gt-label__pin" cx={callout.ax} cy={callout.ay} r="2.8" />
                <line class="gt-label__line" x1={callout.ax} y1={callout.ay} x2={callout.lx + (callout.anchor === 'start' ? -6 : 6)} y2={callout.ly - 4} />
                <text
                  x={callout.lx}
                  y={callout.ly}
                  text-anchor={callout.anchor}
                >
                  {calloutTexts[callout.id]}
                </text>
              </g>
            </a>
          ))
        }
      </svg>
    </div>

    {/* ── 小节 ── */}
    <div class="garden-sections">
      <section id="g-root" class="garden-card">
        <header>
          <p class="garden-kicker">Roots</p>
          <h2>根系 · 来处</h2>
          <p class="garden-desc">往下扎的每一层，都是往上长的底气。</p>
        </header>
        <ul class="root-list">
          {
            roots.map((item) => (
              <li>
                <strong>{item.title}</strong>
                <span>{item.date}</span>
                <em>{item.note}</em>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="g-trunk" class="garden-card">
        <header>
          <p class="garden-kicker">Trunk</p>
          <h2>枝干 · 方向</h2>
          <p class="garden-desc">主干往上，分成两枝。</p>
        </header>
        <div class="branch-grid">
          {
            branches.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
        <p class="garden-note">
          另外对 Causal Discovery in Robotics 心里长草，欢迎来信一起把杂草养成花。
        </p>
      </section>

      <section id="g-leaf" class="garden-card">
        <header>
          <p class="garden-kicker">Leaves</p>
          <h2>叶片 · 做过的事</h2>
          <p class="garden-desc">一叶一个夏天。</p>
        </header>
        <ul class="leaf-list">
          {
            leaves.map((item) => (
              <li>
                <span class="leaf-dot" aria-hidden="true" />
                <strong>{item.title}</strong>
                <span>{item.period}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="g-flower" class="garden-card">
        <header>
          <p class="garden-kicker">Buds</p>
          <h2>花苞 · 还没开</h2>
          <p class="garden-desc">不着急，慢慢来。</p>
        </header>
        <div class="bud-grid">
          {
            buds.map((item) => (
              <article>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                  <path d="M12 22v-8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                  <circle cx="12" cy="10" r="4.2" fill="var(--ch-accent-warm)" opacity=".55" />
                  <path d="M12 5.8c1.6-1.8 3.8-2.2 5.6-1.4-.8 2-2.6 3.4-5.6 3.2Z" fill="var(--ch-accent-warm)" opacity=".75" />
                </svg>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="g-ring" class="garden-card">
        <header>
          <p class="garden-kicker">Rings</p>
          <h2>年轮 · 认真过</h2>
          <p class="garden-desc">一圈一圈，都是长过的痕迹。</p>
        </header>
        <ul class="ring-list">
          {
            rings.map((item, i) => (
              <li style={`--ring-i: ${i}`}>
                <span class="ring-mark" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </section>

      <section id="g-news" class="garden-card">
        <header>
          <p class="garden-kicker">Sprouts</p>
          <h2>抽芽记录 · News</h2>
          <p class="garden-desc">最新的是最顶上那颗新芽。</p>
        </header>
        <ol class="sprout-list">
          {
            sprouts.map((item) => (
              <li>
                <time>{item.date}</time>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ol>
      </section>
    </div>

    <footer class="garden-footer">
      <p>想聊学术，或者只是路过打个招呼 ——</p>
      <div>
        <a class="pill" href="mailto:HenryLiu13550060700@sjtu.edu.cn">Work Email</a>
        <a class="pill pill--glass" href="https://github.com/6chHenry" target="_blank" rel="noopener">GitHub</a>
      </div>
    </footer>
  </section>
</BaseLayout>

<style>
  .garden-page {
    max-width: 62rem;
    padding-bottom: 4rem;
  }

  .garden-actions {
    display: flex;
    gap: 0.7rem;
    margin-top: 1.1rem;
  }

  /* ── 生长之树 ── */
  .tree-wrap {
    margin: 0.4rem 0 2rem;
    padding: 1rem 0.6rem;
    border: 1px solid var(--ch-glass-border);
    border-radius: var(--ch-radius);
    background:
      radial-gradient(circle at 88% 8%, color-mix(in srgb, var(--ch-accent-warm) 10%, transparent), transparent 30%),
      var(--ch-glass-bg);
    backdrop-filter: blur(var(--ch-glass-blur)) saturate(1.12);
    -webkit-backdrop-filter: blur(var(--ch-glass-blur)) saturate(1.12);
    overflow-x: auto;
  }

  .grow-tree {
    display: block;
    width: min(100%, 46rem);
    margin: 0 auto;
    height: auto;

    /* 林相调色板：全部由站点 token 派生 */
    --gt-sun: var(--ch-accent-warm);
    --gt-bird: color-mix(in srgb, var(--ch-fg-muted) 85%, transparent);
    --gt-ground: color-mix(in srgb, var(--ch-accent-secondary) 48%, transparent);
    --gt-grass: color-mix(in srgb, var(--ch-accent-secondary) 55%, transparent);
    --gt-root: color-mix(in srgb, var(--ch-fg) 32%, transparent);
    --gt-trunk: color-mix(in srgb, var(--ch-accent-secondary) 42%, var(--ch-fg));
    --gt-crown: color-mix(in srgb, var(--ch-accent-tertiary) 36%, transparent);
    --gt-crown-soft: color-mix(in srgb, var(--ch-accent-light) 42%, transparent);
    --gt-crown-deep: color-mix(in srgb, var(--ch-accent-secondary) 34%, transparent);
    --gt-bud: var(--ch-accent-warm);
    --gt-ring: color-mix(in srgb, var(--ch-accent-secondary) 40%, transparent);
    --gt-label-line: color-mix(in srgb, var(--ch-fg-muted) 55%, transparent);
  }

  .grow-tree text {
    font-family: var(--ch-text-font);
    font-size: 13.5px;
    letter-spacing: 0.06em;
    fill: var(--ch-fg-muted);
  }

  .gt-label {
    cursor: pointer;
  }

  .grow-tree .gt-label__pin {
    fill: var(--ch-accent-warm);
  }

  .grow-tree .gt-label__line {
    stroke: var(--gt-label-line);
    stroke-width: 1;
    stroke-dasharray: none;
    transition: stroke var(--ch-transition-fast);
  }

  .gt-label text {
    transition: fill var(--ch-transition-fast);
  }

  .gt-label:hover text,
  .gt-label:focus-visible text {
    fill: var(--ch-accent);
  }

  .gt-label:hover .gt-label__line,
  .gt-label:focus-visible .gt-label__line {
    stroke: var(--ch-accent-secondary);
  }

  /* ── 小节卡片 ── */
  .garden-sections {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .garden-card {
    scroll-margin-top: calc(var(--ch-header-height) + 1.5rem);
    padding: 1.5rem 1.65rem;
    border: 1px solid var(--ch-glass-border);
    border-radius: var(--ch-radius);
    background: var(--ch-glass-bg);
    backdrop-filter: blur(var(--ch-glass-blur)) saturate(1.12);
    -webkit-backdrop-filter: blur(var(--ch-glass-blur)) saturate(1.12);
  }

  .garden-kicker {
    display: inline-block;
    margin-bottom: 0.35rem;
    font-family: var(--ch-mono-font);
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ch-accent-tertiary);
  }

  .garden-card h2 {
    margin: 0 0 0.3rem;
    font-family: var(--ch-display-font);
    font-size: 1.42rem;
    color: var(--ch-accent);
  }

  .garden-desc {
    margin: 0 0 1.05rem;
    color: var(--ch-fg-muted);
    font-size: 0.88rem;
  }

  /* 根系 */
  .root-list {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .root-list li {
    display: grid;
    grid-template-columns: auto auto;
    gap: 0.3rem 0.9rem;
    padding: 0.75rem 0.95rem;
    border-left: 3px solid color-mix(in srgb, var(--ch-accent-secondary) 55%, transparent);
    border-radius: 0 var(--ch-radius-sm) var(--ch-radius-sm) 0;
    background: linear-gradient(90deg, var(--ch-accent-dim), transparent);
  }

  .root-list strong {
    font-family: var(--ch-text-font);
    font-size: 0.98rem;
    color: var(--ch-fg);
  }

  .root-list span {
    font-family: var(--ch-mono-font);
    font-size: 0.74rem;
    color: var(--ch-accent-tertiary);
  }

  .root-list em {
    grid-column: 1 / -1;
    color: var(--ch-fg-muted);
    font-size: 0.82rem;
    font-style: normal;
  }

  /* 枝干 */
  .branch-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .branch-grid article {
    padding: 0.95rem 1.05rem;
    border: 1px dashed color-mix(in srgb, var(--ch-accent-secondary) 30%, transparent);
    border-radius: var(--ch-radius-sm);
    background: color-mix(in srgb, var(--ch-surface-solid) 48%, transparent);
  }

  .branch-grid h3 {
    margin: 0 0 0.35rem;
    color: var(--ch-accent-secondary);
    font-size: 1rem;
  }

  .branch-grid p {
    margin: 0;
    color: var(--ch-fg-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .garden-note {
    margin: 0.9rem 0 0;
    padding: 0.6rem 0.85rem;
    border-radius: var(--ch-radius-sm);
    background: color-mix(in srgb, var(--ch-accent-warm) 8%, transparent);
    color: var(--ch-fg);
    font-size: 0.86rem;
  }

  /* 叶片 */
  .leaf-list {
    display: grid;
