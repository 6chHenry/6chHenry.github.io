---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryImage from '../components/GalleryImage.astro';
import ForestIcon from '../components/ForestIcon.astro';
import ForestMap from '../components/ForestMap.astro';
import { buildContentUrl, formatRecencyDate, sortByRecency } from '../utils/content';
import { buildForestMapStops } from '../utils/forest-map';

const base = import.meta.env.BASE_URL;
const heroPhotos = [
  { src: `${base}assets/gallery/photography/kyoto.assets/kifune_shrine.jpg`, alt: 'Kyoto shrine path' },
  { src: `${base}assets/gallery/photography/kobe.assets/kobe_sunset.jpg`, alt: 'Kobe sunset' },
  { src: `${base}assets/gallery/photography/geermu.assets/railway_sunset.jpg`, alt: 'Geermu railway sunset' },
  { src: `${base}assets/gallery/photography/hong-kong.assets/Victoria_Peak.JPG`, alt: 'Hong Kong skyline' },
];

const [notes, essays, projects] = await Promise.all([
  getCollection('notes', ({ data }) => !data.draft),
  getCollection('essay', ({ data }) => !data.draft),
  getCollection('projects', ({ data }) => !data.draft),
]);

const allContent = [...notes, ...essays, ...projects];
const forestStops = buildForestMapStops(allContent, base);
const collectionLabels: Record<string, string> = {
  notes: '笔记',
  essay: '杂谈',
  projects: '作品',
};

const recent = sortByRecency(allContent)
  .filter((entry) => entry.data.updatedAt || entry.data.date)
  .slice(0, 8)
  .map((entry) => ({
    href: buildContentUrl(entry.collection, entry.id, base),
    title: entry.data.title,
    date: formatRecencyDate(entry),
    collection: entry.collection,
    collectionLabel: collectionLabels[entry.collection] ?? '记录',
  }));

const latestNote = sortByRecency(notes)[0];
const latestEssay = sortByRecency(essays)[0];
const latestProject = sortByRecency(projects)[0];

/* 四棵路标树：灯笼松（引路）→ 老橡树（知识年轮）→ 花树（季节）→ 新苗（新枝）。
   树干 pathLength=1 供描线生长动画，树冠 --leaf-i 控制绽放次序。 */
const treeSvgs: Record<string, string> = {
  lantern: `<svg class="trail-tree" viewBox="0 0 90 110" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <g class="tt-canopy">
      <path style="--leaf-i:0" d="M45 14 L60 40 L53 40 L65 58 L55 58 L69 79 L21 79 L35 58 L25 58 L37 40 L30 40 Z" fill="var(--tree-leaf)" fill-opacity=".88" stroke="var(--tree-ink)" stroke-width="2" stroke-linejoin="round"/>
      <path style="--leaf-i:1" d="M45 32 L54 47 L36 47 Z" fill="var(--tree-leaf-soft)" opacity=".8"/>
    </g>
    <g class="tt-trunk">
      <path pathLength="1" d="M45 78 L45 104" stroke="var(--tree-ink)" stroke-width="3"/>
    </g>
    <g>
      <path d="M37 52 C31 55 30 60 30 65" stroke="var(--tree-ink)" stroke-width="1.6"/>
      <circle cx="30" cy="70" r="8" fill="var(--tree-glow)" opacity=".26"/>
      <path style="--leaf-i:2" d="M27 66 a3 3 0 0 1 6 0 v5 a3 3 0 0 1 -6 0 Z" fill="var(--tree-glow)" stroke="var(--tree-ink)" stroke-width="1.4"/>
    </g>
  </svg>`,
  oak: `<svg class="trail-tree" viewBox="0 0 90 110" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <g class="tt-trunk">
      <path pathLength="1" d="M45 104 C44 90 47 76 44 62 C42 52 43 46 45 40" stroke="var(--tree-ink)" stroke-width="3.4"/>
      <path pathLength="1" d="M38 104 C40 97 42 92 43 87" stroke="var(--tree-ink)" stroke-width="2.2"/>
      <path pathLength="1" d="M52 104 C50 96 48 91 46 86" stroke="var(--tree-ink)" stroke-width="2.2"/>
      <path pathLength="1" d="M44 60 C37 55 31 54 26 49" stroke="var(--tree-ink)" stroke-width="2.2"/>
      <path pathLength="1" d="M45 52 C52 47 57 46 62 42" stroke="var(--tree-ink)" stroke-width="2.2"/>
    </g>
    <g class="tt-canopy">
      <circle style="--leaf-i:0" cx="45" cy="32" r="19" fill="var(--tree-leaf)" fill-opacity=".9" stroke="var(--tree-ink)" stroke-width="2"/>
      <circle style="--leaf-i:1" cx="27" cy="41" r="11" fill="var(--tree-leaf)" fill-opacity=".78" stroke="var(--tree-ink)" stroke-width="1.8"/>
      <circle style="--leaf-i:2" cx="62" cy="39" r="12" fill="var(--tree-leaf-soft)" opacity=".85" stroke="var(--tree-ink)" stroke-width="1.8"/>
      <circle style="--leaf-i:3" cx="38" cy="23" r="8" fill="var(--tree-leaf-soft)" opacity=".7" stroke="var(--tree-ink)" stroke-width="1.6"/>
    </g>
  </svg>`,
  blossom: `<svg class="trail-tree" viewBox="0 0 90 110" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <g class="tt-trunk">
      <path pathLength="1" d="M43 104 C47 90 39 76 45 62 C49 52 47 44 49 36" stroke="var(--tree-ink)" stroke-width="2.4"/>
      <path pathLength="1" d="M45 68 C52 64 57 59 59 52" stroke="var(--tree-ink)" stroke-width="2"/>
      <path pathLength="1" d="M44 60 C38 56 34 50 33 44" stroke="var(--tree-ink)" stroke-width="2"/>
    </g>
    <g class="tt-canopy">
      <circle style="--leaf-i:0" cx="50" cy="30" r="10.5" fill="var(--tree-leaf-soft)" opacity=".85" stroke="var(--tree-ink)" stroke-width="1.8"/>
      <circle style="--leaf-i:1" cx="37" cy="39" r="7.5" fill="var(--tree-leaf-soft)" opacity=".75" stroke="var(--tree-ink)" stroke-width="1.6"/>
      <circle style="--leaf-i:2" cx="58" cy="41" r="7" fill="var(--tree-leaf)" fill-opacity=".72" stroke="var(--tree-ink)" stroke-width="1.6"/>
      <g style="--leaf-i:3">
        <circle cx="50" cy="22" r="2.2" fill="var(--tree-glow)"/>
        <circle cx="42" cy="32" r="2" fill="var(--tree-glow)"/>
        <circle cx="57" cy="33" r="2" fill="var(--tree-glow)"/>
        <circle cx="33" cy="43" r="1.9" fill="var(--tree-glow)"/>
      </g>
    </g>
  </svg>`,
  sapling: `<svg class="trail-tree" viewBox="0 0 90 110" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <g class="tt-trunk">
      <path pathLength="1" d="M45 104 C45 93 44 84 45 74" stroke="var(--tree-ink)" stroke-width="2.4"/>
      <path pathLength="1" d="M45 74 C45 66 50 61 56 59" stroke="var(--tree-ink)" stroke-width="2"/>
      <path pathLength="1" d="M45 77 C40 71 38 65 40 58" stroke="var(--tree-ink)" stroke-width="2"/>
      <path pathLength="1" d="M39 104 C38 99 35 96 31 95" stroke="var(--tree-ink)" stroke-width="1.8"/>
      <path pathLength="1" d="M51 104 C52 99 55 96 59 95" stroke="var(--tree-ink)" stroke-width="1.8"/>
    </g>
    <g class="tt-canopy">
      <path style="--leaf-i:0" d="M56 59 C62 54 68 55 71 60 C65 64 58 63 56 59 Z" fill="var(--tree-leaf-soft)" opacity=".92" stroke="var(--tree-ink)" stroke-width="1.6"/>
      <path style="--leaf-i:1" d="M40 58 C35 53 29 53 26 58 C31 62 37 61 40 58 Z" fill="var(--tree-leaf-soft)" opacity=".9" stroke="var(--tree-ink)" stroke-width="1.6"/>
      <path style="--leaf-i:2" d="M45 89 C41 86 40 81 42 77 C46 80 47 85 45 89 Z" fill="var(--tree-leaf)" fill-opacity=".85" stroke="var(--tree-ink)" stroke-width="1.5"/>
      <path style="--leaf-i:3" d="M45 82 C49 79 50 74 48 70 C44 73 43 78 45 82 Z" fill="var(--tree-leaf)" fill-opacity=".85" stroke="var(--tree-ink)" stroke-width="1.5"/>
      <circle style="--leaf-i:4" cx="45" cy="73" r="2.6" fill="var(--tree-glow)"/>
    </g>
  </svg>`,
};

const paths: Array<{
  index: string;
  icon: 'leaf' | 'book' | 'pen' | 'code';
  title: string;
  description: string;
  href: string;
  lift: string;
  tree: keyof typeof treeSvgs;
  sway: string;
  count?: string;
  latest?: { date?: string; title: string };
}> = [
  {
    index: '01',
    icon: 'leaf' as const,
    title: '认识我',
    description: '我的坐标、兴趣与正在寻找的问题',
    href: `${base}about/`,
    lift: '10.625rem',
    tree: 'lantern',
    sway: '5.6s',
  },
  {
    index: '02',
    icon: 'book' as const,
    title: '翻阅笔记',
    description: 'AI、数学与工程学习留下的知识年轮',
    href: `${base}notes/`,
    lift: '7.75rem',
    tree: 'oak',
    sway: '4.6s',
    count: `${notes.length} 篇笔记`,
    latest: latestNote && {
      date: formatRecencyDate(latestNote),
      title: latestNote.data.title,
    },
  },
  {
    index: '03',
    icon: 'pen' as const,
    title: '读些杂谈',
    description: '旅行、电影与生活片段的私人标本',
    href: `${base}essay/`,
    lift: '4.875rem',
    tree: 'blossom',
    sway: '4.1s',
    count: `${essays.length} 则杂谈`,
    latest: latestEssay && {
      date: formatRecencyDate(latestEssay),
      title: latestEssay.data.title,
    },
  },
  {
    index: '04',
    icon: 'code' as const,
    title: '看看作品',
    description: '从模型到界面，把想法做成可体验的作品',
    href: `${base}projects/`,
    lift: '2.25rem',
    tree: 'sapling',
    sway: '3.7s',
    count: `${projects.length} 个项目`,
    latest: latestProject && {
      date: formatRecencyDate(latestProject),
      title: latestProject.data.title,
    },
  },
];
---

<BaseLayout title="6ch. · 林间笔记" description="在森林般的宽阔里，记录 AI、视觉与思考的片段" bodyClass="page-home">
  <section class="home-hero">
    <div class="home-sky" aria-hidden="true"></div>
    <div class="home-stars" aria-hidden="true"></div>
    <div class="home-hills" aria-hidden="true"></div>
    <div class="home-treeline" aria-hidden="true"></div>
    <div class="home-mist" aria-hidden="true"></div>
    <div class="home-light" aria-hidden="true"></div>
    <div class="home-grain" aria-hidden="true"></div>
    <canvas class="home-fireflies" aria-hidden="true"></canvas>
    <div class="home-photo-collage" aria-hidden="true">
      {
        heroPhotos.map((photo, index) => (
          <figure class={`home-photo home-photo--${index + 1}`}>
            <GalleryImage
              src={photo.src}
              alt={photo.alt}
              sizes="(max-width: 720px) 72vw, 28rem"
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
            />
          </figure>
        ))
      }
    </div>

    <div class="home-inner">
      <div class="home-avatar-wrap">
        <img class="home-avatar" src={`${base}img/avatar1.jpg`} alt="6ch." width="124" height="124" />
      </div>
      <p class="home-eyebrow">Forest Journal · Personal Archive</p>
      <h1 class="home-title"><span>6ch.</span></h1>
      <p class="home-tagline">AI / Embodied Intelligence / Travel Notes / Self-directed Inquiry</p>
      <p class="home-subtitle">
        上海交通大学 · 人工智能学院<br />
        把学习、工程和旅行记忆整理成一片可以反复进入的林地。
      </p>
    </div>
  </section>

  <section class="home-trail" aria-labelledby="home-trail-title">
    <header class="home-trail__header">
      <p class="section-kicker">Trailhead · 林地入口</p>
      <h2 id="home-trail-title">选一条路，往林子里走</h2>
      <p class="home-trail__lead">这不是一张站点地图，而是四条进入我的路径。</p>
    </header>

    <nav class="home-trail__nav" aria-label="探索入口">
      <svg class="home-trail__path" viewBox="0 0 1200 416" preserveAspectRatio="none" aria-hidden="true">
        <path
          class="home-trail__path-halo"
          d="M24 210 C80 206 84 200 150 196 C250 192 350 158 450 150 C550 142 650 110 750 104 C850 99 952 74 1050 62 C1100 55 1130 44 1172 30"
          fill="none"
        />
        <path
          class="home-trail__path-line"
          d="M24 210 C80 206 84 200 150 196 C250 192 350 158 450 150 C550 142 650 110 750 104 C850 99 952 74 1050 62 C1100 55 1130 44 1172 30"
          fill="none"
        />
        <circle class="home-trail__start" cx="24" cy="210" r="5" />
        <g class="home-trail__sprout">
          <path d="M1172 30 C1166 20 1158 16 1150 18" />
          <path d="M1150 18 C1144 12 1136 13 1132 19 C1138 23 1145 22 1150 18 Z" />
          <circle cx="1172" cy="30" r="3.4" />
        </g>
      </svg>
      <ol class="home-trail__stops">
        {
          paths.map((path, i) => (
            <li>
              <div class="home-trail__stop" style={`--trail-lift: ${path.lift}; --tree-i: ${i};`}>
                <a
                  class="home-trail__tree-link"
                  href={path.href}
                  aria-label={`${path.title} · ${path.description}`}
                >
                  <span class="home-trail__lean">
                    <span class="home-trail__sway" style={`--sway-d: ${path.sway};`}>
                      <span class="home-trail__tree" set:html={treeSvgs[path.tree]} />
                    </span>
                  </span>
                  <i class="tree-leaf-fall tree-leaf-fall--a" aria-hidden="true" />
                  <i class="tree-leaf-fall tree-leaf-fall--b" aria-hidden="true" />
                  <i class="tree-spark" aria-hidden="true" />
                </a>
                <span class="home-trail__name">
                  <ForestIcon name={path.icon} />
                  {path.title}
                </span>
                <span class="home-trail__desc">{path.description}</span>
                {(path.count || path.latest) && (
                  <span class="home-trail__meta">
                    {path.count && <span class="home-trail__count">{path.count}</span>}
                    {path.latest && <span class="home-trail__latest">最近 · {path.latest.title}</span>}
                  </span>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </nav>

    <footer class="home-trail__footer">
      <p><span>Archive note</span> · 内容仍在生长，路径会随我一起改变。</p>
      <button type="button" class="home-trail__stats" id="home-stats-toggle" aria-expanded="false" aria-controls="statistics">
        <ForestIcon name="tree" />
        <span>查看这片林的年轮</span>
      </button>
    </footer>

    <div id="statistics" class="home-stats" role="region" aria-label="站点统计">
      <div class="home-stats__inner">
        <ul>
          <li>从第一颗种子到现在 <span id="web-time"></span></li>
        </ul>
      </div>
    </div>
  </section>

  {
    recent.length > 0 && (
      <section class="trace-section" aria-labelledby="trace-section-title">
        <header class="trace-section__header">
          <div>
            <p class="section-kicker">Recent traces</p>
            <h2 class="section-title" id="trace-section-title">最近留下的痕迹</h2>
            <p class="section-lead">按时间拾起最近的八次更新，看这片林正在往哪里生长。</p>
          </div>
          <p class="trace-section__count">
            <span>{String(recent.length).padStart(2, '0')}</span> 条新痕迹
          </p>
        </header>
        <ol class="trace-list">
          {recent.map((item) => (
            <li>
              <a class="trace-row" href={item.href}>
                <span class={`trace-row__type trace-row__type--${item.collection}`}>{item.collectionLabel}</span>
                <span class="trace-row__body">
                  <strong class="trace-row__title">{item.title}</strong>
                </span>
                {item.date && <time class="trace-row__date">{item.date}</time>}
                <span class="trace-row__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    forestStops.totalCount > 0 && <ForestMap stops={forestStops} />
  }
</BaseLayout>

<script>
  import { initHomeStats, initTrailReveal } from '../scripts/home';
  import { initFireflies } from '../scripts/fireflies';
  import { initDaypartSky } from '../scripts/daypart';

  initHomeStats();
  initFireflies();
  initDaypartSky();
  initTrailReveal();
</script>
