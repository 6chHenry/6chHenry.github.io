---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const asset = (name: string) => `${base}academy.assets/${name}`;

const interests = [
  {
    title: 'Computer Vision',
    body: 'I love the charm of computer vision, because it makes computers able to see images and videos.',
  },
  {
    title: 'Embodied AI',
    body: 'Building the brain for robots is also interesting for me.',
  },
];

const news = [
  { date: '04/2025', body: 'I was admitted to SAI.' },
  { date: '03/2025', body: 'I became a member of A+ Club of SJTU ME.' },
  { date: '02/2025', body: 'I became a member of Zhiyuan Honor Program, SJTU.' },
  { date: '09/2024', body: 'Excited to start my ME B.Eng. at SJTU ME.' },
];

const education = [
  {
    title: 'School of Artificial Intelligence, Shanghai Jiao Tong University',
    date: 'Apr. 2025 — Present',
    image: 'image-20250425174246126.png',
    alt: 'SAI',
  },
  {
    title: 'Zhiyuan Honor Program, Shanghai Jiao Tong University',
    date: 'Feb. 2025 — Present',
    image: 'sjtu.png',
    alt: 'SJTU',
  },
];

const honors = [
  '2026 美赛 H 奖',
  '2025 年本科生国家奖学金',
  '2025 年致远荣誉奖学金',
  '2025 年本科生 C 等奖学金',
  '2025 年全国大学生数学建模竞赛全国二等奖',
];

const projects = [
  { title: 'LLM Acceleration', period: '2026 春' },
  { title: '语音变声变速', period: '2025 秋' },
  { title: '自动驾驶行为仿真', period: '2025 夏' },
];
---

<BaseLayout title="KeWei Liu | Academic Homepage" description="Academic homepage of KeWei Liu, undergraduate student at Shanghai Jiao Tong University.">
  <section class="container page-shell academy-page">
    <header class="page-header">
      <p class="section-kicker">Academic</p>
      <h1>刘可唯</h1>
      <p class="section-lead">
        KeWei Liu · Undergraduate in AI at the School of Artificial Intelligence, Shanghai Jiao Tong University.
      </p>
    </header>

    <div class="academy-hero">
      <aside class="academy-portrait">
        <img src={asset('academy-avatar.png')} alt="KeWei Liu" width="280" height="280" />
        <p>SAI · SJTU</p>
      </aside>

      <div class="academy-intro">
        <p>
          I am a second-year undergraduate student majoring in AI at
          <a href="https://soai.sjtu.edu.cn/" target="_blank" rel="noopener">SAI</a>
          of
          <a href="https://en.sjtu.edu.cn/" target="_blank" rel="noopener">Shanghai Jiao Tong University</a>.
        </p>
        <p>
          I am currently in the
          <a href="https://en.zhiyuan.sjtu.edu.cn/" target="_blank" rel="noopener">Zhiyuan Honors Program</a>,
          and I am enthusiastic about causal discovery in robotics.
        </p>
        <p class="academy-note">Feel free to reach out if you want to share notes, papers, or a conversation.</p>

        <a class="academy-mail" href="mailto:HenryLiu13550060700@sjtu.edu.cn">
          <span>Email</span>
          HenryLiu13550060700@sjtu.edu.cn
        </a>

        <div class="academy-actions">
          <a class="pill pill--glass" href="https://github.com/6chHenry" target="_blank" rel="noopener">GitHub</a>
          <a class="pill" href={`${base}about/`}>About Me</a>
          <a class="pill pill--glass" href={`${base}academy/garden/`}>林间版</a>
        </div>
      </div>
    </div>

    <section class="academy-block" aria-labelledby="academy-research">
      <h2 class="grove-heading" id="academy-research">
        <span class="grove-heading__rule" aria-hidden="true"></span>
        Research
        <span class="grove-heading__rule" aria-hidden="true"></span>
      </h2>
      <div class="interest-grid">
        {
          interests.map((item) => (
            <article class="interest-card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="academy-block" aria-labelledby="academy-education">
      <h2 class="grove-heading" id="academy-education">
        <span class="grove-heading__rule" aria-hidden="true"></span>
        Education
        <span class="grove-heading__rule" aria-hidden="true"></span>
      </h2>
      <ol class="education-list">
        {
          education.map((item) => (
            <li class="education-item">
              <img src={asset(item.image)} alt="" loading="lazy" />
              <div>
                <h3>{item.title}</h3>
                <p>{item.date}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <div class="academy-split">
      <section class="academy-block" aria-labelledby="academy-honors">
        <h2 class="grove-heading" id="academy-honors">
          <span class="grove-heading__rule" aria-hidden="true"></span>
          Honors
          <span class="grove-heading__rule" aria-hidden="true"></span>
        </h2>
        <ul class="academy-list">
          {honors.map((item) => <li>{item}</li>)}
        </ul>

        <h2 class="grove-heading academy-subhead" id="academy-projects">
          <span class="grove-heading__rule" aria-hidden="true"></span>
          Projects
          <span class="grove-heading__rule" aria-hidden="true"></span>
        </h2>
        <ul class="academy-list">
          {
            projects.map((item) => (
              <li>
                <strong>{item.title}</strong>
                <span>{item.period}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="academy-block" aria-labelledby="academy-news">
        <h2 class="grove-heading" id="academy-news">
          <span class="grove-heading__rule" aria-hidden="true"></span>
          News
          <span class="grove-heading__rule" aria-hidden="true"></span>
        </h2>
        <ol class="news-list">
          {
            news.map((item) => (
              <li>
                <time>{item.date}</time>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .academy-page {
    max-width: 72rem;
    font-family: var(--ch-academic-font);
  }

  .academy-hero {
    display: grid;
    grid-template-columns: 16.5rem minmax(0, 1fr);
    gap: 2.25rem;
    align-items: start;
    margin-bottom: 3.25rem;
  }

  .academy-portrait {
    position: relative;
  }

  .academy-portrait img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--ch-radius);
    border: 1px solid var(--ch-glass-border);
    box-shadow: var(--ch-shadow);
  }

  .academy-portrait p {
    margin: 0.85rem 0 0;
    color: var(--ch-accent-tertiary);
    font-family: var(--ch-mono-font);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .academy-intro {
    max-width: 40rem;
    padding-top: 0.35rem;
  }

  .academy-intro p {
    margin: 0 0 0.9rem;
    color: var(--ch-fg-muted);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .academy-intro a {
    color: var(--ch-accent-secondary);
  }

  .academy-note {
    padding-left: 0.85rem;
    border-left: 3px solid var(--ch-accent-secondary);
    color: var(--ch-fg);
  }

  .academy-mail {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0.35rem 0 1.15rem;
    color: var(--ch-fg);
    text-decoration: none;
  }

  .academy-mail span {
    color: var(--ch-accent-tertiary);
    font-family: var(--ch-mono-font);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .academy-mail:hover {
    color: var(--ch-accent-secondary);
  }

  .academy-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .academy-block {
    margin-bottom: 2.75rem;
  }

  .academy-subhead {
    margin-top: 2.25rem;
  }

  .interest-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .interest-card {
    padding: 1.25rem 1.3rem;
    border-radius: var(--ch-radius);
    border: 1px solid var(--ch-glass-border);
    background: var(--ch-glass-bg);
    backdrop-filter: blur(var(--ch-glass-blur)) saturate(1.08);
    -webkit-backdrop-filter: blur(var(--ch-glass-blur)) saturate(1.08);
  }

  .interest-card h3 {
    margin: 0 0 0.45rem;
    color: var(--ch-accent);
    font-family: var(--ch-display-font);
    font-size: 1.2rem;
    font-weight: 600;
  }

  .interest-card p {
    margin: 0;
    color: var(--ch-fg-muted);
    line-height: 1.65;
  }

  .education-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .education-item {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1.1rem;
    align-items: center;
    padding: 0.85rem 1rem;
    border-radius: var(--ch-radius-sm);
    border: 1px solid var(--ch-glass-border);
    background: var(--ch-glass-bg);
  }

  .education-item img {
    width: 4.5rem;
    height: 3.4rem;
    object-fit: contain;
    border-radius: 0.45rem;
    background: color-mix(in srgb, var(--ch-surface-solid) 88%, transparent);
  }

  .education-item h3 {
    margin: 0;
    color: var(--ch-fg);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .education-item p {
    margin: 0.28rem 0 0;
    color: var(--ch-accent-tertiary);
    font-family: var(--ch-mono-font);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .academy-split {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.9fr);
    gap: 2.5rem;
    align-items: start;
  }

  .academy-list {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .academy-list li {
    margin: 0;
    padding-left: 0.85rem;
    border-left: 2px solid color-mix(in srgb, var(--ch-accent-secondary) 35%, transparent);
    color: var(--ch-fg-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .academy-list strong {
    display: block;
    color: var(--ch-fg);
    font-weight: 600;
  }

  .academy-list span {
    color: var(--ch-accent-tertiary);
    font-family: var(--ch-mono-font);
    font-size: 0.72rem;
  }

  .news-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .news-list li {
    display: grid;
    gap: 0.2rem;
    padding-left: 0.95rem;
    border-left: 2px solid var(--ch-accent-tertiary);
  }

  .news-list time {
    color: var(--ch-accent-tertiary);
    font-family: var(--ch-mono-font);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .news-list p {
    margin: 0;
    color: var(--ch-fg);
    line-height: 1.55;
  }

  @media (max-width: 860px) {
    .academy-hero,
    .academy-split,
    .interest-grid {
      grid-template-columns: 1fr;
    }

    .academy-portrait {
      max-width: 14rem;
    }
  }
</style>
