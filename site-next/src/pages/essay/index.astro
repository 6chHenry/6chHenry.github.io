    background:
      linear-gradient(145deg, color-mix(in srgb, var(--ch-surface-solid) 64%, transparent), color-mix(in srgb, var(--ch-accent-dim) 46%, transparent)),
      radial-gradient(circle at 88% 14%, color-mix(in srgb, var(--ch-accent-warm) 9%, transparent), transparent 38%);
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 28%, transparent);
    color: inherit;
    text-decoration: none;
    transition:
      transform var(--ch-transition-fast),
