      linear-gradient(180deg, transparent 48%, color-mix(in srgb, var(--ch-accent) 42%, transparent)),
      radial-gradient(circle at 22% 12%, color-mix(in srgb, var(--ch-accent-warm) 18%, transparent), transparent 38%);
