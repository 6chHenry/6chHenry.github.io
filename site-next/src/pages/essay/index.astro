      linear-gradient(150deg, color-mix(in srgb, var(--ch-accent) 28%, var(--ch-surface-solid)), color-mix(in srgb, var(--ch-accent-warm) 14%, var(--ch-surface-solid))),
      repeating-linear-gradient(90deg, color-mix(in srgb, white 7%, transparent) 0 1px, transparent 1px 10px);
  }

  .essay-card__poster img {
