    padding: 1.15rem 1.25rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ch-accent-warm) 28%, var(--ch-glass-border));
    border-radius: 10px;
    background:
      linear-gradient(112deg, color-mix(in srgb, var(--ch-accent) 13%, var(--ch-surface-solid)), color-mix(in srgb, var(--ch-surface-solid) 64%, transparent) 55%, color-mix(in srgb, var(--ch-accent-warm) 10%, var(--ch-surface-solid))),
      repeating-linear-gradient(90deg, transparent 0 16px, color-mix(in srgb, var(--ch-accent-warm) 5%, transparent) 16px 17px);
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 26%, transparent);
    color: inherit;
    text-decoration: none;
    transition:
      transform var(--ch-transition-fast),
      border-color var(--ch-transition-fast),
      box-shadow var(--ch-transition-fast);
