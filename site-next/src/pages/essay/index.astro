---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryImage from '../../components/GalleryImage.astro';
import { watchlist2026 } from '../../data/watchlist';
import { buildContentUrl, formatRecencyDate, sortByRecency } from '../../utils/content';
import { buildEssayExcerpt, getEntryCoverImage, getMoviePosterFromBody, getTravelGalleryLink, getTravelPoster } from '../../utils/essay-visuals';

const entries = sortByRecency(await getCollection('essay', ({ data }) => !data.draft));
const base = import.meta.env.BASE_URL;
const watchlistHref = `${base}essay/2026-watchlist/`;

const categoryMeta = {
  Movies: { title: '影评', desc: '电影、剧集和观看后的余温。', order: 10 },
  Music: { title: '歌评', desc: '专辑、单曲和阶段性的听歌整理。', order: 20 },
  Travel: { title: '旅行', desc: '路线、城市、路上的流水账，以及照片留下的旁证。', order: 30 },
  Reading: { title: '书评', desc: '读完一本书之后，留给作品的回信。', order: 40 },
  Life: { title: '生活', desc: '生日、学期、关系和个人生活切片。', order: 50 },
  Thoughts: { title: '思考', desc: '关于人、技术、效率和自我状态的短文。', order: 60 },
  Plans: { title: '计划与总结', desc: '阶段计划、周结和年度复盘。', order: 70 },
  Misc: { title: '杂项', desc: '暂时没有归入固定主题的文字。', order: 90 },
} as const;

type CategoryKey = keyof typeof categoryMeta;

function inferCategory(id: string): CategoryKey {
  const [top] = id.split('/');
  if (top && top in categoryMeta) return top as CategoryKey;
  if (/计划|总结|周结|review plan|week\d+|2025/i.test(id)) return 'Plans';
  if (/游记|港澳|香港|京都|大阪|神户|姬路/.test(id)) return 'Travel';
  if (/书评|情书/.test(id)) return 'Reading';
  if (/生日|后记|冬至|情感|复合|学期|高中|18岁/.test(id)) return 'Life';
  if (/ai|j人|二倍速|懒惰|睡眠|杂谈/.test(id.toLowerCase())) return 'Thoughts';
  return 'Misc';
}

const groupedEntries = [
  ...entries
    .reduce((groups, entry) => {
      const key = inferCategory(entry.id);
      const current = groups.get(key) ?? [];
      current.push(entry);
      groups.set(key, current);
      return groups;
    }, new Map<CategoryKey, typeof entries>())
    .entries(),
]
  .sort(([a], [b]) => categoryMeta[a].order - categoryMeta[b].order)
  .map(([key, items]) => ({ key, ...categoryMeta[key], entries: items }));

function getEntryHref(entry: (typeof entries)[number]) {
  return buildContentUrl('essay', entry.id, base);
}

function getEntryExcerpt(entry: (typeof entries)[number]) {
  return entry.data.description ?? buildEssayExcerpt(entry.body, entry.data.title);
}

/* 树洞树：八棵共用的墨线树干（不用 defs，避免多实例 id 冲突）。
   洞口中心约在 x 50% / y 52%，信笺与光晕按此定位。 */
const hollowTreeSvg = `<svg class="hollow-svg" viewBox="0 0 120 150" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <path d="M10 -4 C16 8 12 20 18 32" stroke="var(--hollow-leaf)" stroke-width="2" opacity=".5"/>
  <path d="M108 -6 C102 6 106 16 100 26" stroke="var(--hollow-leaf)" stroke-width="2" opacity=".4"/>
  <g>
    <path d="M36 148 C34 118 40 92 38 64 C37 44 42 28 47 12 L74 12 C80 30 84 48 82 70 C80 96 86 122 84 148 Z"
      fill="var(--hollow-bark)" stroke="var(--hollow-ink)" stroke-width="2.5" stroke-linejoin="round"/>
    <path d="M46 132 C45 108 49 88 47 66" stroke="var(--hollow-ink)" stroke-width="1.6" opacity=".45"/>
    <path d="M67 138 C69 112 65 92 68 70" stroke="var(--hollow-ink)" stroke-width="1.6" opacity=".45"/>
    <path d="M55 40 C57 32 56 24 58 16" stroke="var(--hollow-ink)" stroke-width="1.4" opacity=".4"/>
    <circle cx="72" cy="50" r="3" stroke="var(--hollow-ink)" stroke-width="1.4" opacity=".5"/>
    <path d="M30 148 C36 142 39 135 40 127" stroke="var(--hollow-ink)" stroke-width="3" opacity=".85"/>
    <path d="M90 148 C84 142 81 134 80 125" stroke="var(--hollow-ink)" stroke-width="3" opacity=".85"/>
  </g>
  <g class="hollow-mouth">
    <ellipse class="hollow-glow" cx="61" cy="78" rx="14" ry="11" fill="var(--ch-accent-warm)"/>
    <path d="M46 76 C44 64 52 56 61 56 C71 56 79 64 77 77 C76 89 69 96 60 96 C51 96 47 88 46 76 Z"
      fill="rgb(24 17 10 / 93%)" stroke="color-mix(in srgb, var(--ch-accent-warm) 42%, transparent)" stroke-width="2"/>
  </g>
</svg>`;
---

<BaseLayout title="杂谈 | 6ch. · 林间笔记" description="6ch. 的随笔、影评与旅行札记">
  <section class="container page-shell essay-page">
    <header class="page-header essay-page__header">
      <p class="section-kicker">Essays</p>
      <h1>杂谈</h1>
      <p class="section-lead">不完全是目录，更像几只抽屉：电影票根、旅行照片、读书回声和某些突然亮起的念头。</p>
    </header>

    <div class="essay-drawers-sentinel" aria-hidden="true"></div>

    <div class="essay-viewbar">
      <div class="essay-viewbar__switch" data-view-switch data-view="expanded" role="group" aria-label="切换页面形态">
        <span class="essay-viewbar__thumb" aria-hidden="true"></span>
        <button type="button" class="essay-viewbar__btn" data-view-btn="expanded" aria-pressed="true">展阅</button>
        <button type="button" class="essay-viewbar__btn" data-view-btn="collected" aria-pressed="false">收纳</button>
      </div>
    </div>

    <nav class="essay-drawers" data-drawer-nav aria-label="杂谈分类快速跳转">
      <div class="essay-drawers__rail">
        {
          groupedEntries.map((group) => (
            <a class="essay-drawers__tab" href={`#essay-section-${group.key}`} data-drawer-tab={group.key}>
              <span class="essay-drawers__tab-title">{group.title}</span>
              <span class="essay-drawers__tab-count">{group.entries.length}</span>
            </a>
          ))
        }
      </div>
    </nav>

    {/* 收纳形态：树洞信笺——随笔投进树洞，散页悬停时会被收进洞里 */}
    <div class="essay-hollows" data-essay-trays hidden>
      {
        groupedEntries.map((group, trayIndex) => {
          const latest = group.entries[0];
          return (
            <a
              class:list={['essay-hollow', `essay-hollow--v${trayIndex % 3}`]}
              href={`#essay-section-${group.key}`}
              style={`--tray-i: ${trayIndex}; --tint: ${(trayIndex % 3) * 6 - 6}deg;`}
            >
              <span class="essay-hollow__scene" aria-hidden="true">
                <span class="essay-hollow__tree" set:html={hollowTreeSvg} />
                <span class="essay-hollow__moss" />
                <span class="essay-hollow__tucked">
                  {latest && <i>{latest.data.title}</i>}
                  <i />
                  <i />
                </span>
                <i class="essay-hollow__loose essay-hollow__loose--a" />
                <i class="essay-hollow__loose essay-hollow__loose--b" />
                <span class="essay-hollow__detail" />
              </span>
              <span class="essay-hollow__tag">
                <strong>{group.title}</strong>
                <span>{group.entries.length} 篇</span>
              </span>
            </a>
          );
        })
      }
    </div>

    <div class="essay-groups">
      {
        groupedEntries.map((group) => (
          <section
            id={`essay-section-${group.key}`}
            class:list={['essay-group', `essay-group--${group.key.toLowerCase()}`]}
            aria-labelledby={`essay-group-${group.key}`}
          >
            <header class="essay-group__header">
              <div>
                <p class="section-kicker">{group.key}</p>
                <h2 id={`essay-group-${group.key}`}>{group.title}</h2>
                <p>{group.desc}</p>
              </div>
              <span>{group.entries.length} 篇</span>
            </header>

            <ul class:list={['essay-card-grid', group.key === 'Movies' && 'essay-card-grid--posters', group.key === 'Travel' && 'essay-card-grid--travel']}>
              {
                group.entries.map((entry) => {
                  const href = getEntryHref(entry);
                  const excerpt = getEntryExcerpt(entry);
                  const date = formatRecencyDate(entry);
                  const isMovie = group.key === 'Movies';
                  const isTravel = group.key === 'Travel';
                  const gallery = isTravel ? getTravelGalleryLink(entry.id, base) : undefined;
                  const poster = isMovie ? getMoviePosterFromBody(entry.body, entry.id) : undefined;
                  const travelPoster = isTravel ? getTravelPoster(entry.id, base) : undefined;
                  const maxShow = 6;
                  const visiblePhotos = travelPoster ? travelPoster.photos.slice(0, maxShow) : [];
                  const photoOverflow = travelPoster ? travelPoster.photos.length - maxShow : 0;
                  const layoutVariant = travelPoster ? (entry.id.length + travelPoster.photos.length) % 3 : 0;
                  const coverImage = !isMovie && !isTravel && !entry.id.includes('高中回忆录') ? getEntryCoverImage(entry.body) : null;

                  return (
                    <li>
                      {isMovie ? (
                        <a class:list={['essay-card', 'essay-card--movie', poster && 'has-image']} href={href}>
                          <span class="essay-card__poster" aria-hidden={poster ? 'true' : undefined}>
                            {poster ? (
                              <img src={poster} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                            ) : (
                              <span class="essay-card__poster-type">{entry.data.title}</span>
                            )}
                          </span>
                          <span class="essay-card__body">
                            <span class="essay-card__kicker">影评</span>
                            <strong>{entry.data.title}</strong>
                            <span>{excerpt}</span>
                            {date && <time>{date}</time>}
                          </span>
                        </a>
                      ) : isTravel && travelPoster ? (
                        <article class="essay-card essay-card--travel-poster">
                          <div class="essay-card__body">
                            <span class="essay-card__kicker">旅行札记</span>
                            <h3>
                              <a href={href}>{entry.data.title}</a>
                            </h3>
                            <p>{excerpt}</p>
                            <div class="essay-card__meta">
                              {date && <time>{date}</time>}
                              <a href={travelPoster.galleryHref}>图集 · {travelPoster.galleryTitle} →</a>
                            </div>
                          </div>
                          <div
                            class="travel-eye"
                            aria-hidden="true"
                            data-count={visiblePhotos.length}
                            data-variant={layoutVariant}
                          >
                            {visiblePhotos.map((src, i) => {
                              const roles = ['main', 'accent-1', 'accent-2', 'accent-3', 'accent-4', 'accent-5'];
                              return (
                                <span class:list={['travel-eye__photo', `travel-eye__photo--${roles[i] || `accent-${i}`}`]}>
                                  <GalleryImage
                                    src={src}
                                    alt=""
                                    sizes="(max-width: 720px) 44vw, 18rem"
                                    loading="lazy"
                                  />
                                </span>
                              );
                            })}
                            {photoOverflow > 0 && (
                              <span class="travel-eye__overflow">+{photoOverflow}</span>
                            )}
                            <span class="travel-eye__cities">{travelPoster.cities}</span>
                          </div>
                        </article>
                      ) : isTravel ? (
                        <article class="essay-card essay-card--travel">
                          {gallery && (
                            <a class="essay-card__photo" href={gallery.href} aria-label={`打开图集：${gallery.title}`}>
                              <GalleryImage
                                src={gallery.cover}
                                alt={gallery.coverAlt}
                                sizes="(max-width: 720px) 100vw, 22rem"
                                loading="lazy"
                              />
                            </a>
                          )}
                          <div class="essay-card__body">
                            <span class="essay-card__kicker">旅行札记</span>
                            <h3>
                              <a href={href}>{entry.data.title}</a>
                            </h3>
                            <p>{excerpt}</p>
                            <div class="essay-card__meta">
                              {date && <time>{date}</time>}
                              {gallery && <a href={gallery.href}>对应图集 · {gallery.title}</a>}
                            </div>
                          </div>
                        </article>
                      ) : (
                        <a class:list={['essay-card', 'essay-card--text', coverImage && 'essay-card--with-cover']} href={href} style={coverImage ? `--cover-image: url(${coverImage})` : ''}>
                          <span class="essay-card__body">
                            <span class="essay-card__kicker">{group.title}</span>
                            <strong>{entry.data.title}</strong>
                            <span>{excerpt}</span>
                            {date && <time>{date}</time>}
                          </span>
                        </a>
                      )}
                    </li>
                  );
                })
              }
            </ul>

            {group.key === 'Movies' && (
              <a class="year-watchlist" href={watchlistHref} aria-label="打开 2026 观影清单">
                <span class="year-watchlist__mark" aria-hidden="true">
                  <i></i><i></i><i></i><i></i>
                </span>
                <span class="year-watchlist__copy">
                  <span>2026 · Viewing log</span>
                  <strong>2026 观影清单</strong>
                  <small>{watchlist2026.length} 部已看，沿着这一年的银幕继续往前。</small>
                </span>
                <span class="year-watchlist__action">查看清单 <i aria-hidden="true">↗</i></span>
              </a>
            )}
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .essay-page {
    padding-bottom: 4rem;
  }

  /* ── 抽屉索引牌：页首的快速跳转，吸顶成毛玻璃标签条 ── */

  .essay-drawers-sentinel {
    height: 1px;
  }

  .essay-drawers {
    position: sticky;
    top: var(--ch-header-height);
    z-index: 20;
    margin: 1.7rem 0 2.8rem;
    padding: 0.6rem 0;
    transition:
      background var(--ch-transition),
      box-shadow var(--ch-transition),
      border-color var(--ch-transition);
    border-bottom: 1px solid transparent;
  }

  .essay-drawers.is-stuck {
    border-bottom-color: var(--ch-border-soft);
    background: color-mix(in srgb, var(--ch-surface-solid) 80%, transparent);
    backdrop-filter: blur(14px) saturate(1.12);
    -webkit-backdrop-filter: blur(14px) saturate(1.12);
    box-shadow: 0 12px 30px color-mix(in srgb, var(--ch-fg) 8%, transparent);
  }

  .essay-drawers__rail {
    position: relative;
    display: flex;
    gap: 0.5rem;
    padding: 0.15rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .essay-drawers__rail::-webkit-scrollbar {
    display: none;
  }

  /* ── 形态切换：展阅 ⇄ 收纳 ── */

  .essay-viewbar {
    display: flex;
    justify-content: flex-end;
    margin-top: -2.6rem;
    margin-bottom: 1.3rem;
  }

  .essay-viewbar__switch {
    position: relative;
    display: inline-grid;
    grid-auto-flow: column;
    padding: 0.24rem;
    border: 1px solid color-mix(in srgb, var(--ch-accent-secondary) 26%, var(--ch-border));
    border-radius: 999px;
    background: color-mix(in srgb, var(--ch-surface-solid) 60%, transparent);
    backdrop-filter: blur(10px) saturate(1.1);
    -webkit-backdrop-filter: blur(10px) saturate(1.1);
  }

  .essay-viewbar__thumb {
    position: absolute;
    top: 0.24rem;
    bottom: 0.24rem;
    left: 0.24rem;
    width: calc(50% - 0.24rem);
    border-radius: 999px;
    background: linear-gradient(150deg, color-mix(in srgb, var(--ch-accent-warm) 88%, white), color-mix(in srgb, var(--ch-accent-warm) 70%, #7a5a2b));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 45%),
      0 4px 12px color-mix(in srgb, var(--ch-accent-warm) 40%, transparent);
    transition: transform 360ms cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .essay-viewbar__switch[data-view='collected'] .essay-viewbar__thumb {
    transform: translateX(100%);
  }

  .essay-viewbar__btn {
    position: relative;
    z-index: 1;
    min-width: 4.8rem;
    padding: 0.44rem 0.9rem;
    border: 0;
    background: none;
    color: var(--ch-fg-muted);
    font-family: var(--ch-text-font);
    font-size: 0.86rem;
    letter-spacing: 0.14em;
    cursor: pointer;
    transition: color var(--ch-transition-fast);
  }

  .essay-viewbar__btn[aria-pressed='true'] {
    color: #2b1d08;
    font-weight: 700;
  }

  /* 收纳形态样式：树洞信笺 */

.essay-groups[hidden],
.essay-hollows[hidden],
[data-drawer-nav][hidden],
.essay-drawers-sentinel[hidden] {
  display: none !important;
}

.essay-hollows {
  --hollows-floor: color-mix(in srgb, var(--ch-accent-ink) 13%, var(--ch-bg-mist));
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1rem;
  padding: 1.9rem 1.5rem 1.3rem;
  border: 1px solid color-mix(in srgb, var(--ch-accent-ink) 28%, var(--ch-border));
  border-radius: 16px;
  background:
    radial-gradient(130% 100% at 50% -12%, transparent 42%, color-mix(in srgb, var(--ch-accent-ink) 13%, transparent)),
    repeating-linear-gradient(90deg, color-mix(in srgb, var(--ch-fg) 3%, transparent) 0 3px, transparent 3px 92px),
    linear-gradient(180deg, color-mix(in srgb, var(--ch-bg-sky) 52%, transparent) 0%, var(--hollows-floor) 58%),
    var(--ch-surface-elevated);
  box-shadow:
    inset 0 1px 0 color-mix(in srgb, white 28%, transparent),
    inset 0 -20px 36px color-mix(in srgb, var(--ch-accent-ink) 15%, transparent),
    0 18px 44px color-mix(in srgb, var(--ch-fg) 10%, transparent);
  overflow: hidden;
  animation: essay-trays-in 0.55s ease both;
}

@keyframes essay-trays-in {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
}

.essay-hollow {
  --hollow-leaf: color-mix(in srgb, var(--ch-accent-tertiary) 68%, transparent);
  --hollow-ink: color-mix(in srgb, var(--ch-fg) 72%, var(--ch-accent-ink));
  --hollow-bark: color-mix(
    in srgb,
    color-mix(in srgb, var(--ch-accent-warm) 30%, var(--ch-bg-hill)) 84%,
    var(--ch-surface-solid)
  );
  position: relative;
  display: block;
  padding: 0.3rem 0.4rem 2.7rem;
  border-radius: 10px;
  color: inherit;
  text-decoration: none;
  filter: hue-rotate(var(--tint, 0deg));
  transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  animation: hollow-pop 0.5s cubic-bezier(0.34, 1.45, 0.64, 1) both;
  animation-delay: calc(var(--tray-i) * 70ms);
}

@keyframes hollow-pop {
  from {
    opacity: 0;
    transform: translateY(14px) scale(0.95);
  }
}

.essay-hollow:hover,
.essay-hollow:focus-visible {
  transform: translateY(-4px);
}

.essay-hollow:focus-visible {
  outline: 2px dashed color-mix(in srgb, var(--ch-accent-warm) 78%, transparent);
  outline-offset: 4px;
  border-radius: 12px;
}

.essay-hollow__scene {
  position: relative;
  display: block;
  transform-origin: 50% 96%;
  transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
}

.essay-hollow:hover .essay-hollow__scene,
.essay-hollow:focus-visible .essay-hollow__scene {
  transform: rotate(-1.1deg);
}

.hollow-svg {
  display: block;
  width: 100%;
  height: auto;
  overflow: visible;
}

.hollow-glow {
  opacity: 0.14;
  transform-box: fill-box;
  transform-origin: center;
  transition:
    opacity 380ms ease,
    transform 460ms cubic-bezier(0.22, 1, 0.36, 1);
}

.essay-hollow:hover .hollow-glow,
.essay-hollow:focus-visible .hollow-glow {
  opacity: 0.34;
  transform: scale(1.22);
}

.essay-hollow__moss {
  position: absolute;
  bottom: 0;
  left: 5%;
  right: 5%;
  height: 10%;
  background: radial-gradient(
    50% 100% at 50% 50%,
    color-mix(in srgb, var(--ch-accent-secondary) 28%, transparent),
    transparent 74%
  );
  filter: blur(2px);
}

.essay-hollow__tucked {
  position: absolute;
  left: 51%;
  top: 52%;
  width: 17%;
  height: 25%;
  transform: translateX(-50%);
  transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
}

.essay-hollow:hover .essay-hollow__tucked,
.essay-hollow:focus-visible .essay-hollow__tucked {
  transform: translateX(-50%) translateY(6%) scale(0.97);
}

.essay-hollow__tucked i {
  position: absolute;
  bottom: 6%;
  left: 50%;
  display: block;
  width: 100%;
  height: 92%;
  border-radius: 1.5px;
  background:
    repeating-linear-gradient(
      180deg,
      transparent 0 7px,
      color-mix(in srgb, var(--ch-fg-muted) 30%, transparent) 7px 8px
    )
    no-repeat 8% 30% / 84% 46%,
    color-mix(in srgb, var(--ch-bg-mist) 92%, white);
  box-shadow: 0 1px 3px rgb(0 0 0 / 38%);
  transform-origin: 50% 100%;
}

.essay-hollow__tucked i:nth-child(1) {
  transform: translateX(-50%) rotate(-4deg);
  z-index: 3;
}

.essay-hollow__tucked i:nth-child(2) {
  transform: translateX(-60%) rotate(8deg) scale(0.93);
  opacity: 0.85;
}

.essay-hollow__tucked i:nth-child(3) {
  transform: translateX(-40%) rotate(-12deg) scale(0.89);
  opacity: 0.72;
}

.essay-hollow__loose {
  position: absolute;
  width: 15%;
  height: 19%;
  border-radius: 1.5px;
  background:
    repeating-linear-gradient(
      180deg,
      transparent 0 6px,
      color-mix(in srgb, var(--ch-fg-muted) 26%, transparent) 6px 7px
    )
    no-repeat 12% 26% / 76% 52%,
    color-mix(in srgb, var(--ch-bg-mist) 94%, white);
  box-shadow: 0 2px 4px rgb(0 0 0 / 24%);
  transition:
    left 640ms cubic-bezier(0.3, 0.9, 0.3, 1),
    bottom 640ms cubic-bezier(0.3, 0.9, 0.3, 1),
    transform 640ms cubic-bezier(0.3, 0.9, 0.3, 1),
    opacity 460ms ease;
}

.essay-hollow__loose--a {
  left: 10%;
  bottom: 4%;
  transform: rotate(-14deg);
}

.essay-hollow__loose--b {
  right: 9%;
  bottom: 8%;
  height: 16%;
  transform: rotate(12deg);
}

.essay-hollow:hover .essay-hollow__loose--a,
.essay-hollow:focus-visible .essay-hollow__loose--a {
  left: 44%;
  bottom: 42%;
  opacity: 0;
  transform: rotate(74deg) scale(0.42);
  transition-delay: 60ms;
}

.essay-hollow:hover .essay-hollow__loose--b,
.essay-hollow:focus-visible .essay-hollow__loose--b {
  left: 52%;
  bottom: 40%;
  opacity: 0;
  transform: rotate(-68deg) scale(0.38);
  transition-delay: 190ms;
}

.essay-hollow__tag {
  position: absolute;
  top: 12%;
  right: 1%;
  z-index: 2;
  display: grid;
  gap: 0.04rem;
  justify-items: center;
  padding: 0.32rem 0.5rem 0.3rem;
  border: 1px solid color-mix(in srgb, var(--hollow-ink) 40%, var(--ch-border-soft));
  border-radius: 3px;
  background: color-mix(in srgb, var(--ch-bg-mist) 92%, white);
  box-shadow: 0 3px 8px rgb(0 0 0 / 18%);
  transform: rotate(4deg);
  transform-origin: 50% -0.6rem;
}

.essay-hollow__tag::before {
  position: absolute;
  bottom: 100%;
  left: 50%;
  width: 1px;
  height: 0.62rem;
  background: repeating-linear-gradient(to bottom, var(--hollow-ink) 0 2px, transparent 2px 4px);
  content: '';
  opacity: 0.7;
}

.essay-hollow__tag strong {
  color: var(--ch-fg);
  font-family: var(--ch-display-font);
  font-size: 0.84rem;
  font-weight: 650;
  letter-spacing: 0.18em;
  white-space: nowrap;
}

.essay-hollow__tag span {
  color: var(--ch-accent-warm);
  font-family: var(--ch-mono-font);
  font-size: 0.56rem;
}

.essay-hollow:hover .essay-hollow__tag,
.essay-hollow:focus-visible .essay-hollow__tag {
  animation: hollow-tag-sway 1.5s ease-in-out;
}

@keyframes hollow-tag-sway {
  0%,
  100% {
    transform: rotate(4deg);
  }

  30% {
    transform: rotate(10deg);
  }

  65% {
    transform: rotate(-1deg);
  }
}

.essay-hollow__detail {
  position: absolute;
  bottom: 2%;
  left: 16%;
  width: 14%;
  height: 7%;
}

.essay-hollow__detail::before,
.essay-hollow__detail::after {
  position: absolute;
  bottom: 0;
  content: '';
}

.essay-hollow--v0 .essay-hollow__detail::before {
  left: 0;
  width: 0.34rem;
  height: 0.34rem;
  border-radius: 50% 50% 40% 40%;
  background: color-mix(in srgb, #b06a3f 76%, var(--ch-fg));
}

.essay-hollow--v0 .essay-hollow__detail::after {
  left: 0.5rem;
  bottom: -0.05rem;
  width: 0.24rem;
  height: 0.24rem;
  border-radius: 50%;
  background: color-mix(in srgb, #b06a3f 60%, var(--ch-fg));
  opacity: 0.85;
}

.essay-hollow--v1 .essay-hollow__detail {
  left: auto;
  right: 14%;
}

.essay-hollow--v1 .essay-hollow__detail::before {
  left: 0;
  bottom: 0;
  width: 0.42rem;
  height: 0.5rem;
  border-radius: 80% 20% 80% 20%;
  background: color-mix(in srgb, var(--ch-accent-tertiary) 80%, var(--ch-fg));
  transform: rotate(-18deg);
}

.essay-hollow--v1 .essay-hollow__detail::after {
  left: 0.4rem;
  width: 0.36rem;
  height: 0.42rem;
  border-radius: 20% 80% 20% 80%;
  background: color-mix(in srgb, var(--ch-accent-tertiary) 66%, var(--ch-fg));
  transform: rotate(22deg);
}

.essay-hollow--v2 .essay-hollow__detail::before {
  left: 0.1rem;
  width: 0.3rem;
  height: 0.3rem;
  border-radius: 50%;
  background: color-mix(in srgb, var(--ch-fg-muted) 55%, var(--ch-border));
}

.essay-hollow--v2 .essay-hollow__detail::after {
  left: 0.55rem;
  bottom: 0.02rem;
  width: 0.44rem;
  height: 0.44rem;
  border-radius: 50% 50% 40% 40%;
  background: color-mix(in srgb, #b06a3f 66%, var(--ch-fg));
}

  .essay-drawers__tab {
