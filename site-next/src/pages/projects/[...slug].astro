---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import PaimonCaseStudy from '../../components/PaimonCaseStudy.astro';
import { buildContentUrl, normalizeSlug, sortByRecency } from '../../utils/content';
import { buildCharacterTreeSvg, treeClipId } from '../../utils/character-tree';
import { loadCharacterCorpus, portraitsForRendered, forestCharUrl, forestDir } from '../../utils/character-lexicon';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const entries = await getCollection('projects', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: normalizeSlug(entry.id) },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const isPaimonCaseStudy = entry.id === 'PaimonAsksEverything/paimon-asks-everything.md';
const { Content, headings } = await render(entry);
const filteredHeadings = headings.filter((h) => h.depth <= 3);
const headingTexts = filteredHeadings.map((h) => h.text);
const characterBones = portraitsForRendered(
  await loadCharacterCorpus(import.meta.env.BASE_URL),
  entry,
  headingTexts,
);
const characterTreeSvg = buildCharacterTreeSvg({
  seed: entry.id,
  portraits: characterBones,
  title: entry.data.title,
  headings: headingTexts,
  body: entry.body ?? '',
  clipId: treeClipId(entry.id),
  hrefForChar: (char) => forestCharUrl(char, import.meta.env.BASE_URL),
});
const entries = sortByRecency(await getCollection('projects', ({ data }) => !data.draft));
const currentIndex = entries.findIndex((item) => item.id === entry.id);
const previousEntry = currentIndex >= 0 ? entries[currentIndex + 1] : undefined;
const nextEntry = currentIndex > 0 ? entries[currentIndex - 1] : undefined;
---

{
  isPaimonCaseStudy ? (
    <PaimonCaseStudy
      entry={entry}
      previous={
        previousEntry && {
          title: previousEntry.data.title,
          description: previousEntry.data.description,
          href: buildContentUrl('projects', previousEntry.id),
        }
      }
      next={
        nextEntry && {
          title: nextEntry.data.title,
          description: nextEntry.data.description,
          href: buildContentUrl('projects', nextEntry.id),
        }
      }
    />
  ) : (
    <ContentLayout
      title={entry.data.title}
      description={entry.data.description}
      date={entry.data.date}
      tags={entry.data.tags}
      headings={filteredHeadings.map((h) => ({ depth: h.depth, slug: h.slug, text: h.text }))}
      characterTreeSvg={characterTreeSvg}
      characterBones={characterBones.map((item) => item.char)}
      characterCharBase={forestDir(import.meta.env.BASE_URL)}
      previous={
        previousEntry && {
          title: previousEntry.data.title,
          description: previousEntry.data.description,
          href: buildContentUrl('projects', previousEntry.id),
        }
      }
      next={
        nextEntry && {
          title: nextEntry.data.title,
          description: nextEntry.data.description,
          href: buildContentUrl('projects', nextEntry.id),
        }
      }
    >
      <Content />
    </ContentLayout>
  )
}
