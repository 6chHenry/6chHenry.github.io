---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { loadCharacterCorpus } from '../../utils/character-lexicon';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const corpus = await loadCharacterCorpus();
  return [...corpus.inverted.keys()].map((zi) => ({
    params: { zi },
    props: { zi },
  }));
}) satisfies GetStaticPaths;

const { zi } = Astro.props;
const base = import.meta.env.BASE_URL;
const corpus = await loadCharacterCorpus(base);
const matches = corpus.inverted.get(zi) ?? [];
const collectionLabels: Record<string, string> = {
  notes: '笔记',
  essay: '杂谈',
  projects: '作品',
};
---

<BaseLayout title={`「${zi}」 | 汉字森林 | 6ch.`} description={`共用汉字「${zi}」的笔记、杂谈与作品`}>
  <section class="container page-shell hanzi-forest-char">
    <header class="page-header">
      <p class="section-kicker">
        <a href={`${base}forest/`}>汉字森林</a>
      </p>
      <h1 class="hanzi-forest-char__glyph">{zi}</h1>
      <p class="section-lead">{matches.length} 篇把这个字写进了自己的冠层。</p>
    </header>

    <ul class="content-list">
      {
        matches.map((entry) => (
          <li>
            <ContentCard
              href={entry.href}
              title={entry.title}
              description={`冠层权重 ${entry.count} · 作为这篇的特别字出现`}
              collection={collectionLabels[entry.collection] ?? entry.collection}
            />
          </li>
        ))
      }
    </ul>

    {
      matches.length === 0 && (
        <p>
          这个字还没有住进任何一篇的冠层。回到
          <a href={`${base}forest/`}>汉字森林</a>
          看看别的字。
        </p>
      )
    }
  </section>
</BaseLayout>

<style>
  .hanzi-forest-char__glyph {
    font-family: var(--ch-display-font);
    font-size: clamp(3.2rem, 8vw, 5.4rem);
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .hanzi-forest-char .section-kicker a {
    color: inherit;
    text-decoration: none;
  }

  .hanzi-forest-char .section-kicker a:hover {
    color: var(--ch-accent);
  }
</style>
