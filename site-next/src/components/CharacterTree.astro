---
interface Props {
  svg: string;
  bones?: string[];
  label?: string;
  charBase?: string;
  living?: boolean;
  class?: string;
}

const { svg, bones = [], label = '本篇的字', charBase, living = true, class: className } = Astro.props;
---

<figure class:list={['character-tree', className]} data-character-tree data-living={living ? 'true' : 'false'}>
  <p class="character-tree__title">{label}</p>
  <div class="character-tree__canvas">
    <Fragment set:html={svg} />
  </div>
  {
    bones.length > 0 && (
      <p class="character-tree__bones" aria-label="本篇特别的字">
        {bones.map((char, index) => (
          <>
            {index > 0 && ' · '}
            {charBase ? (
              <a href={`${charBase}${encodeURIComponent(char)}/`}>{char}</a>
            ) : (
              <span>{char}</span>
            )}
          </>
        ))}
      </p>
    )
  }
  <p class="character-tree__tip" data-tree-tip hidden></p>
</figure>

<script>
  const trees = document.querySelectorAll<HTMLElement>('[data-character-tree]');
  trees.forEach((tree) => {
    const tip = tree.querySelector<HTMLElement>('[data-tree-tip]');
    const canvas = tree.querySelector('.character-tree__canvas');
    if (!tip || !canvas) return;

    const sourceLabel = (source: string, heading: string) => {
      if (source === 'title') return '标题';
      if (source === 'heading' && heading) return heading;
      if (source === 'heading') return '小节';
      return '正文';
    };

    const hide = () => {
      tip.hidden = true;
      tip.textContent = '';
    };

    canvas.addEventListener('pointerover', (event) => {
      const glyph = (event.target as Element | null)?.closest?.('text[data-char]') as SVGTextElement | null;
      if (!glyph) return;
      const char = glyph.dataset.char ?? '';
      const count = glyph.dataset.count ?? '0';
      const where = sourceLabel(glyph.dataset.source ?? '', glyph.dataset.heading ?? '');
      tip.hidden = false;
      tip.textContent = `${char} · ${where} · ${count} 次`;
    });

    canvas.addEventListener('pointerleave', hide);

    const glyphs = Array.from(canvas.querySelectorAll<SVGTextElement>('text[data-char]'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (tree.dataset.living === 'false' || reduceMotion || glyphs.length === 0) return;

    tree.classList.add('is-living');
    const grow = (glyph: SVGTextElement) => glyph.classList.add('is-grown');
    glyphs.filter((glyph) => glyph.dataset.source === 'title').forEach(grow);

    const byHeading = new Map<string, SVGTextElement[]>();
    for (const glyph of glyphs) {
      const heading = glyph.dataset.heading?.trim();
      if (!heading) continue;
      const list = byHeading.get(heading) ?? [];
      list.push(glyph);
      byHeading.set(heading, list);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const text = entry.target.textContent?.replace(/\s+/g, ' ').trim() ?? '';
          byHeading.get(text)?.forEach(grow);
        }
      },
      { rootMargin: '-18% 0px -42% 0px', threshold: 0.05 },
    );
    document.querySelectorAll('.prose h2, .prose h3').forEach((heading) => observer.observe(heading));

    const bodyGlyphs = glyphs
      .filter((glyph) => glyph.dataset.source === 'body')
      .sort((a, b) => Number(b.dataset.rank ?? 0) - Number(a.dataset.rank ?? 0));

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollable > 0 ? Math.min(1, window.scrollY / scrollable) : 1;
        const visible = Math.ceil(progress * bodyGlyphs.length);
        bodyGlyphs.forEach((glyph, index) => {
          if (index < visible) grow(glyph);
        });
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  });
</script>
