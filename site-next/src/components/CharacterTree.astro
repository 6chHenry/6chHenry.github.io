---
interface Props {
  svg: string;
  bones?: string[];
  label?: string;
  charBase?: string;
  living?: boolean;
  class?: string;
}

const { svg, bones = [], label = '文字树', charBase, living = true, class: className } = Astro.props;
---

<figure class:list={['character-tree', className, living && 'is-living']} data-character-tree data-living={living ? 'true' : 'false'}>
  <p class="character-tree__title">{label}</p>
  <div class="character-tree__canvas">
    <Fragment set:html={svg} />
  </div>
  {
    bones.length > 0 && (
      <p class="character-tree__bones" aria-label="这棵树上特别的字">
        {bones.map((char, index) => (
          <>
            {index > 0 && ' · '}
            {charBase ? (
              <a href={`${charBase}${encodeURIComponent(char)}/`}>{char}</a>
            ) : (
              <span>{char}</span>
            )}
          </>
        ))}
      </p>
    )
  }
  <p class="character-tree__tip" data-tree-tip hidden></p>
</figure>

<script>
  const trees = document.querySelectorAll<HTMLElement>('[data-character-tree]');
  trees.forEach((tree) => {
    const tip = tree.querySelector<HTMLElement>('[data-tree-tip]');
    const canvas = tree.querySelector('.character-tree__canvas');
    if (!tip || !canvas) return;

    const sourceLabel = (source: string, heading: string) => {
      if (source === 'title') return '标题';
      if (source === 'heading' && heading) return heading;
      if (source === 'heading') return '小节';
      return '正文';
    };

    const hide = () => {
      tip.hidden = true;
      tip.textContent = '';
    };

    canvas.addEventListener('pointerover', (event) => {
      const glyph = (event.target as Element | null)?.closest?.('text[data-char]') as SVGTextElement | null;
      if (!glyph) return;
      const char = glyph.dataset.char ?? '';
      const count = glyph.dataset.count ?? '0';
      const where = sourceLabel(glyph.dataset.source ?? '', glyph.dataset.heading ?? '');
      tip.hidden = false;
      tip.textContent = `${char} · ${where} · ${count} 次`;
    });

    canvas.addEventListener('pointerleave', hide);

    const glyphs = Array.from(canvas.querySelectorAll<SVGTextElement>('text[data-char]'));
    if (tree.dataset.living === 'false' || glyphs.length === 0) return;

    tree.classList.add('is-living');
    const grownOpacity = (glyph: SVGTextElement) =>
      glyph.style.getPropertyValue('--char-opacity').trim() || '0.86';
    const grow = (glyph: SVGTextElement) => {
      if (glyph.classList.contains('is-grown')) return;
      glyph.classList.add('is-grown');
      glyph.setAttribute('opacity', grownOpacity(glyph));
    };
    glyphs.forEach((glyph) => {
      if (glyph.dataset.source === 'title') return;
      glyph.setAttribute('opacity', '0.05');
    });
    glyphs.filter((glyph) => glyph.dataset.source === 'title').forEach(grow);

    const pending = glyphs
      .filter((glyph) => glyph.dataset.source !== 'title')
      .sort((a, b) => Number(b.getAttribute('y')) - Number(a.getAttribute('y')));

    const article = document.querySelector<HTMLElement>('.content-article');
    const readingProgress = () => {
      const page = document.documentElement.scrollHeight - window.innerHeight;
      const pageP = page > 0 ? window.scrollY / page : 0;
      if (!article) return Math.min(1, Math.max(0, pageP));
      const header = document.querySelector('header');
      const headerOffset = header?.getBoundingClientRect().height || 68;
      const rect = article.getBoundingClientRect();
      const scrollable = article.offsetHeight - (window.innerHeight - headerOffset) * 0.35;
      const articleP =
        scrollable > 0 ? (headerOffset - rect.top) / scrollable : 0;
      return Math.min(1, Math.max(0, pageP, articleP));
    };

    const byHeading = new Map<string, SVGTextElement[]>();
    for (const glyph of pending) {
      const heading = glyph.dataset.heading?.trim();
      if (!heading) continue;
      const list = byHeading.get(heading) ?? [];
      list.push(glyph);
      byHeading.set(heading, list);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const text = entry.target.textContent?.replace(/\s+/g, ' ').trim() ?? '';
          byHeading.get(text)?.forEach(grow);
        }
      },
      { rootMargin: '-12% 0px -48% 0px', threshold: 0.05 },
    );
    document.querySelectorAll('.prose h2, .prose h3').forEach((heading) => observer.observe(heading));

    const sprout = () => {
      const visible = Math.ceil(readingProgress() * pending.length);
      pending.forEach((glyph, index) => {
        if (index < visible) grow(glyph);
      });
    };
    window.addEventListener('scroll', sprout, { passive: true });
    document.addEventListener('scroll', sprout, { passive: true });
    sprout();
  });
</script>
