---
/**
 * 林间小精灵「苔苔」：全站漂浮的苔藓光茧精。
 * 交互逻辑见 ../scripts/forest-sprite.ts。
 */
---

<div class="forest-sprite">
  <div class="forest-sprite__shadow" aria-hidden="true"></div>
  <button type="button" class="forest-sprite__body" aria-label="苔苔 · 林间小精灵（点击聊天，拖拽移动，双击送回角落）">
    <span class="forest-sprite__tilt" aria-hidden="true">
      <span class="forest-sprite__float">
        <svg viewBox="0 0 96 108" width="100%" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="fs-moss" x1="0" y1="0" x2="0.35" y2="1">
              <stop offset="0%" stop-color="#4c8a63" />
              <stop offset="100%" stop-color="#2c523c" />
            </linearGradient>
          </defs>

          <!-- 光茧 -->
          <circle class="fs-glow-halo" cx="40" cy="11" r="8.5" fill="var(--ch-accent-warm)" opacity="0.26" />
          <circle class="fs-glow-core" cx="40" cy="11" r="3.6" fill="var(--ch-accent-warm)" />

          <!-- 头顶新芽 -->
          <path d="M48 31 C47 25 46 22 42 18" fill="none" stroke="#1b3a2b" stroke-width="2" stroke-linecap="round" />
          <path d="M42 18 C37 13 30 13 26 18 C31 22 38 22 42 18 Z" fill="#4c8a63" stroke="#1b3a2b" stroke-width="1.5" stroke-linejoin="round" />
          <path d="M43 19 C46 15 51 14 54 17 C50 21 45 21 43 19 Z" fill="#5d9770" stroke="#1b3a2b" stroke-width="1.5" stroke-linejoin="round" />

          <!-- 小脚 -->
          <ellipse cx="39" cy="99" rx="5.5" ry="3.4" fill="#2c523c" stroke="#1b3a2b" stroke-width="2" />
          <ellipse cx="57" cy="99" rx="5.5" ry="3.4" fill="#2c523c" stroke="#1b3a2b" stroke-width="2" />

          <!-- 苔藓身子 -->
          <path
            d="M48 30 C66 30 79 45 79 64 C79 83 65 97 48 97 C31 97 17 83 17 64 C17 45 30 30 48 30 Z"
            fill="url(#fs-moss)"
            stroke="#1b3a2b"
            stroke-width="2.5"
            stroke-linejoin="round"
          />

          <!-- 苔斑与肚皮 -->
          <circle cx="30" cy="50" r="2.8" fill="#7db891" opacity="0.55" />
          <circle cx="58" cy="42" r="2.2" fill="#7db891" opacity="0.55" />
          <circle cx="67" cy="68" r="3" fill="#7db891" opacity="0.5" />
          <circle cx="36" cy="78" r="2.4" fill="#7db891" opacity="0.5" />
          <ellipse cx="48" cy="74" rx="15" ry="11" fill="#5d9770" opacity="0.45" />

          <!-- 脸 -->
          <g class="fs-eyes">
            <circle cx="39" cy="57" r="4.4" fill="#14281d" />
            <circle cx="59" cy="57" r="4.4" fill="#14281d" />
            <circle class="fs-pupil" cx="37.6" cy="55.4" r="1.4" fill="#f4fbf4" opacity="0.92" />
            <circle class="fs-pupil" cx="57.6" cy="55.4" r="1.4" fill="#f4fbf4" opacity="0.92" />
          </g>
          <circle cx="31" cy="64" r="2.8" fill="#d99a6c" opacity="0.4" />
          <circle cx="67" cy="64" r="2.8" fill="#d99a6c" opacity="0.4" />
          <path d="M43.5 67 Q48 71 52.5 67" fill="none" stroke="#14281d" stroke-width="2" stroke-linecap="round" />
        </svg>
      </span>
    </span>
  </button>
  <div class="forest-sprite__bubble" role="status"></div>
</div>

<!-- 首帧前就位：解析到此处立即恢复上次被拖拽的位置，避免先出现在左上角再跳走 -->
<script is:inline>
  (() => {
    const el = document.querySelector('.forest-sprite');
    if (!el) return;
    let saved = null;
    try {
      const raw = localStorage.getItem('forest-sprite:v1');
      if (raw) {
        const parsed = JSON.parse(raw);
        if (typeof parsed.xPct === 'number' && typeof parsed.yPct === 'number') saved = parsed;
      }
    } catch {}
    const w = el.offsetWidth || 72;
    const h = el.offsetHeight || 82;
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    /* 边界规则与 forest-sprite.ts 的 clamp 保持一致 */
    const x = saved ? Math.min(Math.max(saved.xPct * vw, 10), Math.max(10, vw - w - 10)) : vw - w - 26;
    const y = saved ? Math.min(Math.max(saved.yPct * vh, 74), Math.max(74, vh - h - 10)) : vh - h - 26;
    el.style.transform = `translate(${x}px, ${y}px)`;
    el.setAttribute('data-placed', '');
  })();
</script>

<style>
  .forest-sprite {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: 4.5rem;
    height: 5.1rem;
    pointer-events: none;
    will-change: transform;
  }

  .forest-sprite__shadow {
    position: absolute;
    bottom: -0.35rem;
    left: 22%;
    width: 56%;
    height: 0.6rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 26%), transparent);
    animation: fs-shadow 3.6s ease-in-out infinite alternate;
  }

  .forest-sprite__body {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: grab;
    pointer-events: auto;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
  }

  .forest-sprite.is-dragging .forest-sprite__body {
    cursor: grabbing;
  }

  .forest-sprite__body:focus-visible {
    outline: 2px dashed var(--ch-accent-warm);
    outline-offset: 6px;
    border-radius: 42%;
  }

  .forest-sprite__tilt,
  .forest-sprite__float {
    display: block;
    width: 100%;
    height: 100%;
  }

  .forest-sprite__float {
    animation: fs-bob 3.6s ease-in-out infinite alternate;
    transform-origin: 50% 100%;
  }

  /* 就位后的轻柔落定：每次翻页都稳稳出现在原地 */
  .forest-sprite[data-placed] .forest-sprite__float {
    animation:
      fs-arrive 0.7s cubic-bezier(0.34, 1.4, 0.64, 1) both,
      fs-bob 3.6s ease-in-out 0.7s infinite alternate;
  }

  @keyframes fs-arrive {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.86);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  .forest-sprite.is-dragging .forest-sprite__float {
    animation-play-state: paused;
  }

  .forest-sprite.is-dragging .forest-sprite__body svg {
    transform: scale(1.07);
  }

  svg {
    display: block;
    overflow: visible;
    transform-origin: 50% 92%;
    transition: transform 180ms ease;
  }

  /* 悬停：小身子朝鼠标方向倾一点、微微放大 */
  .forest-sprite__body:hover svg {
    transform: rotate(var(--lean, 0deg)) scale(1.05);
  }

  .fs-glow-halo {
    transform-box: fill-box;
    transform-origin: center;
    animation: fs-pulse 2.8s ease-in-out infinite;
  }

  .fs-glow-core {
    animation: fs-glow 2.8s ease-in-out infinite;
  }

  .fs-eyes {
    transform-box: fill-box;
    transform-origin: center;
    animation: fs-blink 5.4s infinite;
    transition: transform 150ms ease;
  }

  .forest-sprite.is-happy .fs-eyes {
    animation: none;
    transform: scaleY(0.15);
  }

  /* ── 动效系统：瞳孔 / 点击 / 闲置小剧场 ── */

  .fs-pupil {
    transform: translate(var(--eye-x, 0px), var(--eye-y, 0px));
    transition: transform 140ms ease-out;
  }

  .forest-sprite.is-talking svg {
    animation: fs-bounce 620ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .forest-sprite.is-talking .fs-glow-halo {
    animation: fs-flash 620ms ease-out;
  }

  .forest-sprite.is-look .fs-pupil {
    animation: fs-look 1.7s ease-in-out;
  }

  .forest-sprite.is-wiggle svg {
    animation: fs-wiggle 1s ease-in-out;
  }

  .forest-sprite.is-doze .fs-eyes {
    animation: fs-doze 2.2s ease-in-out;
  }

  .forest-sprite.is-doze svg {
    animation: fs-droop 2.2s ease-in-out;
  }

  .forest-sprite.is-hop svg {
    animation: fs-hop 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes fs-bounce {
    0% {
      transform: scale(1);
    }

    30% {
      transform: scale(1.1, 0.86);
    }

    60% {
      transform: scale(0.95, 1.07);
    }

    100% {
      transform: scale(1);
    }
  }

  @keyframes fs-flash {
    0% {
      opacity: 0.26;
      transform: scale(1);
    }

    40% {
      opacity: 0.6;
      transform: scale(1.55);
    }

    100% {
      opacity: 0.26;
      transform: scale(1);
    }
  }

  @keyframes fs-look {
    0%,
    100% {
      transform: translate(0, 0);
    }

    30%,
    45% {
      transform: translate(-1.9px, 0.4px);
    }

    70%,
    82% {
      transform: translate(1.9px, 0.2px);
    }
  }

  @keyframes fs-wiggle {
    0%,
    100% {
      transform: rotate(0deg);
    }

    22% {
      transform: rotate(-3.4deg);
    }

    50% {
      transform: rotate(3deg);
    }

    76% {
      transform: rotate(-1.8deg);
    }
  }

  @keyframes fs-doze {
    0%,
    100% {
      transform: scaleY(1);
    }

    38%,
    62% {
      transform: scaleY(0.14);
    }
  }

  @keyframes fs-droop {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }

    40%,
    60% {
      transform: translateY(1.5px) rotate(2.4deg);
    }
  }

  @keyframes fs-hop {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }

    18% {
      transform: translateY(1px) scale(1.08, 0.9);
    }

    52% {
      transform: translateY(-7px) scale(0.96, 1.06);
    }

    86% {
      transform: translateY(0) scale(1.04, 0.96);
    }
  }

  /* ── 对话气泡 ── */

  .forest-sprite__bubble {
    position: absolute;
    bottom: calc(100% + 0.95rem);
    right: 0;
    /* 显式宽度：绝对定位下 auto 宽度会塌缩到父容器（4.5rem），必须写死 */
    width: min(19rem, 78vw);
    padding: 0.58rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--ch-accent-secondary) 32%, var(--ch-border));
    border-radius: 10px;
    background: color-mix(in srgb, var(--ch-surface-solid) 94%, transparent);
    box-shadow: 0 14px 34px rgb(0 0 0 / 16%);
    color: var(--ch-fg);
    font-family: var(--ch-text-font);
    font-size: 0.84rem;
    line-height: 1.65;
    letter-spacing: 0.01em;
    opacity: 0;
    transform: translateY(0.5rem) scale(0.96);
    transform-origin: bottom right;
    pointer-events: none;
    transition:
      opacity 200ms ease,
      transform 240ms cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .forest-sprite__bubble::after {
    position: absolute;
    bottom: -5px;
    right: 1.4rem;
    width: 9px;
    height: 9px;
    border-right: 1px solid color-mix(in srgb, var(--ch-accent-secondary) 32%, var(--ch-border));
    border-bottom: 1px solid color-mix(in srgb, var(--ch-accent-secondary) 32%, var(--ch-border));
    background: color-mix(in srgb, var(--ch-surface-solid) 96%, transparent);
    content: '';
    transform: rotate(45deg);
  }

  .forest-sprite.is-edge-left .forest-sprite__bubble {
    right: auto;
    left: 0;
    transform-origin: bottom left;
  }

  .forest-sprite.is-edge-left .forest-sprite__bubble::after {
    right: auto;
    left: 1.4rem;
  }

  .forest-sprite__bubble.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    cursor: pointer;
  }

  @keyframes fs-bob {
    from {
      transform: translateY(0);
    }

    to {
      transform: translateY(-5px);
    }
  }

  @keyframes fs-shadow {
    from {
      opacity: 0.9;
      transform: scaleX(1);
    }

    to {
      opacity: 0.5;
      transform: scaleX(0.78);
    }
  }

  @keyframes fs-pulse {
    0%,
    100% {
      opacity: 0.26;
      transform: scale(1);
    }

    50% {
      opacity: 0.1;
      transform: scale(1.4);
    }
  }

  @keyframes fs-glow {
    0%,
    100% {
      opacity: 0.82;
    }

    50% {
      opacity: 1;
    }
  }

  @keyframes fs-blink {
    0%,
    91%,
    97%,
    100% {
      transform: scaleY(1);
    }

    94% {
      transform: scaleY(0.08);
    }
  }

  @media (max-width: 640px) {
    .forest-sprite {
      width: 3.75rem;
      height: 4.3rem;
    }

    .forest-sprite__bubble {
      width: min(14rem, 78vw);
      font-size: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .forest-sprite__shadow,
    .forest-sprite__float,
    .forest-sprite[data-placed] .forest-sprite__float,
    .fs-glow-halo,
    .fs-glow-core,
    .fs-eyes,
    .fs-pupil,
    .forest-sprite.is-talking svg,
    .forest-sprite.is-talking .fs-glow-halo,
    .forest-sprite.is-look .fs-pupil,
    .forest-sprite.is-wiggle svg,
    .forest-sprite.is-doze .fs-eyes,
    .forest-sprite.is-doze svg,
    .forest-sprite.is-hop svg {
      animation: none;
    }

    .fs-pupil,
    .forest-sprite__bubble,
    svg {
      transition: none;
    }
  }
</style>

<script>
  import { initForestSprite } from '../scripts/forest-sprite';

  initForestSprite();
</script>
