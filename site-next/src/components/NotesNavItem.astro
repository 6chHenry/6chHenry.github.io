---
import type { NavTreeItem } from '../utils/notes-nav';
import { buildNavPanelId } from '../utils/notes-nav';
import NotesNavItem from './NotesNavItem.astro';

interface Props {
  item: NavTreeItem;
  depth?: number;
}

const { item, depth = 0 } = Astro.props;
const panelId = buildNavPanelId(item.slugPath);
---

{
  item.kind === 'folder' ? (
    <li class="notes-nav-item" data-depth={depth}>
      <button
        type="button"
        class="notes-leaf notes-leaf--folder notes-nav-item__toggle"
        aria-expanded="false"
        aria-controls={panelId}
        data-panel-id={panelId}
      >
        <i class="notes-leaf__node" aria-hidden="true" />
        <span class="notes-leaf__main">
          <strong class="notes-leaf__title">{item.title}</strong>
        </span>
        <em class="notes-leaf__gist">{item.count !== undefined ? `${item.count} 篇` : '展开'}</em>
        <span class="notes-leaf__toggle" aria-hidden="true">
          <svg viewBox="0 0 20 20" fill="none">
            <path
              d="M5 7.75 10 12.5l5-4.75"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </button>
      <ul id={panelId} class="notes-nav-panel content-list">
        {item.children?.map((child) => <NotesNavItem item={child} depth={depth + 1} />)}
      </ul>
    </li>
  ) : item.note ? (
    <li class="notes-nav-item notes-nav-item--leaf" data-depth={depth}>
      <a class="notes-leaf" href={item.note.href}>
        <i class="notes-leaf__node" aria-hidden="true" />
        <span class="notes-leaf__main">
          <strong class="notes-leaf__title">{item.note.title}</strong>
          {item.note.date && <time class="notes-leaf__date">{item.note.date}</time>}
        </span>
        {item.note.gist ? (
          <em class="notes-leaf__gist">{item.note.gist}</em>
        ) : (
          <span class="notes-leaf__gist notes-leaf__gist--empty" aria-hidden="true" />
        )}
      </a>
    </li>
  ) : null
}
