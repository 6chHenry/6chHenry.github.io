---
import ForestIcon from './ForestIcon.astro';

const base = import.meta.env.BASE_URL;

const nav = [
  { href: `${base}`, label: '主页', exact: true },
  { href: `${base}notes/`, label: '笔记' },
  { href: `${base}essay/`, label: '杂谈' },
  { href: `${base}projects/`, label: '项目' },
  { href: `${base}gallery/`, label: '画廊' },
  { href: `${base}academy/`, label: '学术' },
  { href: `${base}tags/`, label: '标签' },
  { href: `${base}about/`, label: '关于' },
];

function isActive(href: string, exact?: boolean) {
  if (exact) return Astro.url.pathname === href || Astro.url.pathname === href.replace(/\/$/, '');
  return Astro.url.pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-logo" href={base}>
      <span class="site-logo__icon" aria-hidden="true">
        <ForestIcon name="tree" />
      </span>
      <span class="site-logo__text">
        <span class="site-logo__name">6ch.</span>
        <span class="site-logo__tag">林间笔记</span>
      </span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={['site-nav__link', { 'is-active': isActive(item.href, item.exact) }]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header__actions">
      <button type="button" class="icon-btn" id="search-open" aria-label="搜索">
        <ForestIcon name="search" />
      </button>
      <button type="button" class="theme-switch" id="theme-toggle" role="switch" aria-checked="false" aria-label="切换昼夜模式">
        <span class="theme-switch__track" aria-hidden="true">
          <span class="theme-switch__stars"></span>
          <span class="theme-switch__knob">
            <span class="theme-switch__icon theme-switch__icon--sun"><ForestIcon name="sun" /></span>
            <span class="theme-switch__icon theme-switch__icon--moon"><ForestIcon name="moon" /></span>
          </span>
        </span>
      </button>
      <a class="icon-btn" href="https://github.com/6chHenry" target="_blank" rel="noopener" aria-label="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.79 23.4c.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.04-3.3.72-4-1.6-4-1.6-.54-1.38-1.33-1.75-1.33-1.75-1.09-.75.08-.73.08-.73 1.2.08 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.63-5.48 5.93.43.37.81 1.1.81 2.22 0 1.6-.01 2.89-.01 3.28 0 .32.21.7.82.58A12 12 0 0 0 12 .5z"/></svg>
      </a>
      <button type="button" class="icon-btn icon-btn--menu" id="nav-toggle" aria-label="打开菜单" aria-expanded="false" aria-controls="site-nav">
        <ForestIcon name="menu" class="nav-icon nav-icon--open" />
        <ForestIcon name="close" class="nav-icon nav-icon--close" />
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--ch-header-height);
    border-bottom: 1px solid var(--ch-border-soft);
    background: color-mix(in srgb, var(--ch-surface-solid) 78%, transparent);
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    height: 100%;
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ch-fg);
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-logo__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 12px;
    background: var(--ch-accent-dim);
    color: var(--ch-accent-secondary);
  }

  .site-logo__icon :global(.forest-icon) {
    width: 1.2rem;
    height: 1.2rem;
  }

  .site-logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .site-logo__name {
    font-family: var(--ch-display-font);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .site-logo__tag {
    font-family: var(--ch-mono-font);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ch-accent-tertiary);
  }

  .site-nav {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }

  .site-nav__link {
    padding: 0.42rem 0.75rem;
    border-radius: 999px;
    color: var(--ch-fg-muted);
    text-decoration: none;
    font-family: var(--ch-display-font);
    font-size: 0.92rem;
    letter-spacing: 0.03em;
    transition:
      color var(--ch-transition-fast),
      background var(--ch-transition-fast);
  }

  .site-nav__link:hover,
  .site-nav__link.is-active {
    color: var(--ch-accent);
    background: var(--ch-accent-dim);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 12px;
    border: 1px solid var(--ch-border-soft);
    background: color-mix(in srgb, var(--ch-surface) 80%, transparent);
    color: var(--ch-fg-muted);
    cursor: pointer;
    text-decoration: none;
    transition:
      color var(--ch-transition-fast),
      border-color var(--ch-transition-fast),
      background var(--ch-transition-fast),
      transform var(--ch-transition-fast);
  }

  .icon-btn:hover {
    color: var(--ch-accent-secondary);
    border-color: color-mix(in srgb, var(--ch-accent-secondary) 45%, var(--ch-border));
    background: var(--ch-accent-dim);
    transform: translateY(-1px);
  }

  .icon-btn svg,
  .icon-btn :global(.forest-icon) {
    width: 1.05rem;
    height: 1.05rem;
    fill: currentColor;
  }

  .icon-btn--menu {
    display: none;
  }

  /* ── 昼夜滑动开关：毛玻璃轨道 + 图标旋钮 ── */

  .theme-switch {
    --switch-w: 3.9rem;
    --switch-h: 2.05rem;
    --switch-pad: 0.19rem;
    --knob-d: 1.67rem;
    --travel: calc(var(--switch-w) - var(--switch-pad) * 2 - var(--knob-d));
    display: inline-flex;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .theme-switch__track {
    position: relative;
    display: block;
    width: var(--switch-w);
    height: var(--switch-h);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ch-accent-secondary) 26%, var(--ch-border));
    border-radius: 999px;
    background:
      linear-gradient(120deg, color-mix(in srgb, var(--ch-accent-warm) 16%, transparent), transparent 55%),
      color-mix(in srgb, var(--ch-surface) 62%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 40%, transparent),
      inset 0 -1px 2px color-mix(in srgb, var(--ch-fg) 6%, transparent),
      0 4px 14px color-mix(in srgb, var(--ch-fg) 10%, transparent);
    backdrop-filter: blur(12px) saturate(1.15);
    -webkit-backdrop-filter: blur(12px) saturate(1.15);
    transition:
      border-color var(--ch-transition-fast),
      box-shadow var(--ch-transition-fast),
      background var(--ch-transition);
  }

  .theme-switch:hover .theme-switch__track,
  .theme-switch:focus-visible .theme-switch__track {
    border-color: color-mix(in srgb, var(--ch-accent-warm) 52%, var(--ch-border));
  }

  .theme-switch:focus-visible {
    outline: 2px dashed color-mix(in srgb, var(--ch-accent-warm) 70%, transparent);
    outline-offset: 3px;
  }

  /* 暗色一侧：夜空渐变 + 两粒小星星 */
  .theme-switch__stars {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 420ms ease;
    background-image:
      radial-gradient(1.4px 1.4px at 24% 38%, rgb(255 255 255 / 90%), transparent 60%),
      radial-gradient(1px 1px at 44% 68%, rgb(214 228 244 / 85%), transparent 55%),
      radial-gradient(1.1px 1.1px at 64% 30%, rgb(255 255 255 / 80%), transparent 60%);
    background-repeat: no-repeat;
  }

  .theme-switch[aria-checked='true'] .theme-switch__track {
    border-color: color-mix(in srgb, #3d5a80 42%, var(--ch-border));
    background:
      linear-gradient(120deg, #16263e 0%, color-mix(in srgb, #12253d 62%, var(--ch-surface)) 70%, color-mix(in srgb, var(--ch-surface) 72%, transparent));
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 12%, transparent),
      inset 0 -1px 2px rgb(0 0 0 / 22%),
      0 4px 14px color-mix(in srgb, #0b1930 32%, transparent);
  }

  .theme-switch[aria-checked='true'] .theme-switch__stars {
    opacity: 0.9;
  }

  .theme-switch__knob {
    position: absolute;
    top: var(--switch-pad);
    left: var(--switch-pad);
    display: grid;
    width: var(--knob-d);
    height: var(--knob-d);
    place-items: center;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 28%, color-mix(in srgb, white 65%, transparent), transparent 46%),
      linear-gradient(145deg, color-mix(in srgb, var(--ch-surface-solid) 92%, transparent), color-mix(in srgb, var(--ch-bg-sky) 34%, var(--ch-surface-solid)));
    box-shadow:
      0 2px 6px color-mix(in srgb, var(--ch-fg) 20%, transparent),
      0 0 0 1px color-mix(in srgb, var(--ch-border) 60%, transparent),
      0 0 10px color-mix(in srgb, var(--ch-accent-warm) 22%, transparent);
    transform: translateX(0);
    transition:
      transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow var(--ch-transition-fast);
  }

  .theme-switch:hover .theme-switch__knob {
    box-shadow:
      0 3px 9px color-mix(in srgb, var(--ch-fg) 24%, transparent),
      0 0 0 1px color-mix(in srgb, var(--ch-border) 60%, transparent),
      0 0 14px color-mix(in srgb, var(--ch-accent-warm) 34%, transparent);
  }

  .theme-switch:active .theme-switch__knob {
    scale: 0.92;
  }

  .theme-switch[aria-checked='true'] .theme-switch__knob {
    transform: translateX(var(--travel));
  }

  /* 旋钮上的太阳/月亮：滑过去的同时旋转交换 */
  .theme-switch__icon {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    width: 0.98rem;
    height: 0.98rem;
    transition:
      transform 460ms cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 300ms ease;
  }

  .theme-switch__icon :global(.forest-icon) {
    width: 100%;
    height: 100%;
  }

  .theme-switch__icon--sun {
    color: var(--ch-accent-warm);
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .theme-switch__icon--moon {
    position: absolute;
    color: #8fa8c9;
    opacity: 0;
    transform: rotate(110deg) scale(0.4);
  }

  .theme-switch[aria-checked='true'] .theme-switch__icon--sun {
    opacity: 0;
    transform: rotate(-110deg) scale(0.4);
  }

  .theme-switch[aria-checked='true'] .theme-switch__icon--moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  @media (max-width: 480px) {
    .theme-switch {
      --switch-w: 3.45rem;
      --switch-h: 1.85rem;
      --knob-d: 1.47rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-switch__track,
    .theme-switch__knob,
    .theme-switch__icon,
    .theme-switch__stars {
      transition-duration: 1ms;
    }
  }

  .nav-icon--close {
    display: none;
  }

  :global(body.nav-open) .nav-icon--open {
    display: none;
  }

  :global(body.nav-open) .nav-icon--close {
    display: inline-flex;
  }

  @media (max-width: 860px) {
    .site-nav {
      display: none;
      position: absolute;
      top: calc(var(--ch-header-height) - 1px);
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0.35rem;
      padding: 1rem 1.25rem 1.25rem;
      border-bottom: 1px solid var(--ch-border-soft);
      background: color-mix(in srgb, var(--ch-surface-solid) 96%, transparent);
      backdrop-filter: blur(16px);
    }

    :global(body.nav-open) .site-nav {
      display: flex;
    }

    .icon-btn--menu {
      display: inline-flex;
    }

    .site-nav__link {
      padding: 0.65rem 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .site-header__inner {
      gap: 0.55rem;
    }

    .site-header__actions {
      gap: 0.25rem;
    }

    .site-header__actions > a[aria-label='GitHub'] {
      display: none;
    }

    .icon-btn {
      width: 2.35rem;
      height: 2.35rem;
    }
  }
</style>

<script>
  import { initThemeToggle } from '../scripts/theme';
  initThemeToggle();

  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = document.body.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      document.body.classList.remove('nav-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
