---
import ForestIcon from './ForestIcon.astro';
---

<div id="search-modal" class="search-modal" hidden>
  <div class="search-modal__backdrop" data-search-close></div>
  <div class="search-modal__panel card card--elevated" role="dialog" aria-modal="true" aria-label="站内搜索">
    <div class="search-modal__header">
      <div>
        <p class="search-modal__kicker">Search the grove</p>
        <h2>站内搜索</h2>
      </div>
      <button type="button" class="search-modal__close" data-search-close aria-label="关闭搜索">
        <ForestIcon name="close" />
      </button>
    </div>
    <div id="pagefind-search"></div>
    <p class="search-modal__hint" data-search-hint>
      <span class="search-modal__hint-name">苔苔</span>
      <span class="search-modal__hint-text">
        想找什么？试试「苔藓」「CNN」「日本游记」；按 <kbd>Esc</kbd> 就把我收回去。
      </span>
    </p>
  </div>
</div>

<style>
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: start center;
    padding: 5rem 1.25rem 2rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--ch-accent-secondary) 46%, transparent) transparent;
  }

  .search-modal[hidden] {
    display: none;
  }

  .search-modal__backdrop {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 5%, color-mix(in srgb, var(--ch-accent-light) 14%, transparent), transparent 28rem),
      var(--ch-scrim);
    backdrop-filter: blur(8px) saturate(1.08);
  }

  .search-modal__panel {
    position: relative;
    width: min(100%, 44rem);
    max-height: calc(100dvh - 7rem);
    overflow-y: auto;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--ch-accent-secondary) 44%, transparent)
      color-mix(in srgb, var(--ch-surface-solid) 32%, transparent);
    padding: 1.25rem 1.35rem 1.35rem;
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 24%, transparent),
      0 28px 80px color-mix(in srgb, black 28%, transparent);
    animation: modal-in 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .search-modal__panel::before {
    position: absolute;
    inset: 0.55rem 0.75rem auto;
    height: 1px;
    content: '';
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ch-accent-warm) 42%, transparent), transparent);
    pointer-events: none;
  }

  .search-modal::-webkit-scrollbar,
  .search-modal__panel::-webkit-scrollbar {
    width: 0.72rem;
  }

  .search-modal::-webkit-scrollbar-track,
  .search-modal__panel::-webkit-scrollbar-track {
    background: transparent;
  }

  .search-modal__panel::-webkit-scrollbar-track {
    border-radius: 999px;
    background: color-mix(in srgb, var(--ch-surface-solid) 28%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ch-border-soft) 65%, transparent);
  }

  .search-modal::-webkit-scrollbar-thumb,
  .search-modal__panel::-webkit-scrollbar-thumb {
    border: 0.22rem solid transparent;
    border-radius: 999px;
    background:
      linear-gradient(
          180deg,
          color-mix(in srgb, var(--ch-accent-tertiary) 72%, var(--ch-surface-solid)),
          color-mix(in srgb, var(--ch-accent-secondary) 68%, var(--ch-accent))
        )
        padding-box;
  }

  .search-modal::-webkit-scrollbar-thumb:hover,
  .search-modal__panel::-webkit-scrollbar-thumb:hover {
    background:
      linear-gradient(
          180deg,
          color-mix(in srgb, var(--ch-accent-light) 78%, var(--ch-surface-solid)),
          color-mix(in srgb, var(--ch-accent-secondary) 82%, var(--ch-accent))
        )
        padding-box;
  }

  @keyframes modal-in {
    from {
      opacity: 0;
      transform: translateY(-12px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .search-modal__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .search-modal__kicker {
    margin: 0 0 0.25rem;
    font-family: var(--ch-mono-font);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ch-accent-tertiary);
    text-shadow: 0 0 18px color-mix(in srgb, var(--ch-accent-tertiary) 18%, transparent);
  }

  .search-modal__header h2 {
    margin: 0;
    font-family: var(--ch-display-font);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--ch-accent);
  }

  .search-modal__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--ch-border-soft);
    border-radius: 12px;
    background:
      linear-gradient(145deg, color-mix(in srgb, white 10%, transparent), transparent 48%),
      color-mix(in srgb, var(--ch-surface) 80%, transparent);
    color: var(--ch-accent-secondary);
    cursor: pointer;
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 18%, transparent);
    transition:
      color var(--ch-transition-fast),
      border-color var(--ch-transition-fast),
      background var(--ch-transition-fast),
      transform var(--ch-transition-fast);
  }

  .search-modal__close:hover,
  .search-modal__close:focus-visible {
    color: var(--ch-accent);
    border-color: color-mix(in srgb, var(--ch-accent-secondary) 45%, var(--ch-border));
    background: var(--ch-accent-dim);
    box-shadow: 0 8px 18px color-mix(in srgb, var(--ch-accent-secondary) 12%, transparent);
    transform: translateY(-1px) rotate(3deg);
  }

  .search-modal__close:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--ch-accent-tertiary) 55%, transparent);
    outline-offset: 2px;
  }

  .search-modal__close :global(.forest-icon) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .search-modal__hint {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin: 0.95rem 0 0;
    padding-top: 0.85rem;
    border-top: 1px dashed color-mix(in srgb, var(--ch-border-soft) 85%, transparent);
    color: var(--ch-fg-muted);
    font-size: 0.84rem;
    line-height: 1.7;
    animation: hint-in 0.32s ease-out both;
  }

  .search-modal__hint[hidden] {
    display: none;
  }

  .search-modal__hint-name {
    flex-shrink: 0;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--ch-accent-secondary) 30%, var(--ch-glass-border));
    background:
      radial-gradient(circle at 30% 15%, color-mix(in srgb, white 28%, transparent), transparent 42%),
      var(--ch-accent-dim);
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 24%, transparent);
    font-family: var(--ch-mono-font);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--ch-accent-secondary);
  }

  .search-modal__hint-text {
    min-width: 0;
  }

  .search-modal__hint kbd {
    padding: 0.05rem 0.32rem;
    border-radius: 0.3rem;
    border: 1px solid var(--ch-border-soft);
    background: var(--ch-accent-dim);
    font-family: var(--ch-mono-font);
    font-size: 0.78em;
    color: var(--ch-accent-secondary);
  }

  @keyframes hint-in {
    from {
      opacity: 0;
      transform: translateY(-3px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  import { initSearchModal } from '../scripts/search';
  initSearchModal();
</script>
