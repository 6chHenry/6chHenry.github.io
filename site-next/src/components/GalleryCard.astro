---
import GalleryImage from './GalleryImage.astro';
import { resolveGalleryImage, resolveGalleryImages } from '../utils/gallery-images';
import type { GalleryChapter } from '../data/gallery-trips';

interface Props {
  href: string;
  cover: string;
  title: string;
  description?: string;
  category: string;
  images: string[];
  imageDescs?: string[];
  chapters?: GalleryChapter[];
  date?: string;
  index: number;
  slug?: string;
}

const { href, cover, title, description, category, images, imageDescs = [], chapters = [], date, index, slug } = Astro.props;
const coverAsset = resolveGalleryImage(cover);
const imageAssets = resolveGalleryImages(images);

const categoryLabels: Record<string, string> = {
  illustration: '插画',
  photography: '摄影',
  design: '设计',
  'ui-ux': 'UI/UX',
  other: '其他',
};

const meta = {
  images: imageAssets,
  imageDescs,
  chapters,
  title,
  description: description ?? '',
  category,
  date: date ?? '',
  detailUrl: href,
};
---

<article
  class="gallery-card"
  data-category={category}
  data-gallery-slug={slug}
  data-gallery-meta={JSON.stringify(meta)}
  tabindex="0"
  role="button"
  aria-label={`预览 ${title}`}
  style={`animation-delay: ${index * 0.08}s`}
>
  <GalleryImage
    class="gallery-card__image"
    asset={coverAsset}
    alt={title}
    sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, 33vw"
    loading={index === 0 ? 'eager' : 'lazy'}
    fetchpriority={index === 0 ? 'high' : 'auto'}
  />
  <span class="gallery-card__category">{categoryLabels[category] ?? category}</span>
  <div class="gallery-card__overlay">
    <h2 class="gallery-card__title">{title}</h2>
    {description && <p class="gallery-card__desc">{description}</p>}
  </div>
  <a class="gallery-card__enter" href={href} aria-label={`进入 ${title}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="5" y1="12" x2="19" y2="12" />
      <polyline points="12 5 19 12 12 19" />
    </svg>
  </a>
</article>
