---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

interface ArticleNavLink {
  title: string;
  href: string;
}

interface Props {
  entry: CollectionEntry<'projects'>;
  previous?: ArticleNavLink;
  next?: ArticleNavLink;
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const shots = `${base}assets/projects/PaimonAsksEverything/paimon-asks-everything.assets/`;
const resolveHref = (href: string) => (href.startsWith('/') ? `${base}${href.slice(1)}` : href);

const liveLink = entry.data.links?.find((link) => link.type === 'demo');
const repoLink = entry.data.links?.find((link) => link.type === 'repo');

const stops = [
  {
    id: 'intel',
    shot: 'home.webp',
    zh: { label: '情报', title: '一张指挥台', text: '倒计时、纸条、至冬影像，版本从这里开始。' },
    en: { label: 'Intel', title: 'One command deck', text: 'Countdown, notes, and Snezhnaya footage live on one rail.' },
  },
  {
    id: 'preheat',
    shot: 'preheat.webp',
    zh: { label: '预热', title: '先认旅行者', text: '地区和身份决定讲到哪一步，而不是同一份导览。' },
    en: { label: 'Preheat', title: 'Know the traveler', text: 'Region and profile decide how much to reveal.' },
  },
  {
    id: 'ask',
    shot: 'ask.webp',
    zh: { label: '问答', title: '先查证，再开口', text: '两条检索可切换。没有出处，派蒙不编。' },
    en: { label: 'Ask', title: 'Verify, then speak', text: 'Two search routes. No source, no answer.' },
  },
  {
    id: 'insights',
    shot: 'insights.webp',
    zh: { label: '洞察', title: '信号变成动作', text: '匿名问题收成制作组下一两周能做的事。' },
    en: { label: 'Insights', title: 'Signals to action', text: 'Anonymous questions become the next two weeks of work.' },
  },
  {
    id: 'lab',
    shot: 'lab.webp',
    zh: { label: '实验', title: '增量不过线，就先不投', text: '给谁看什么，用区间说话，而不是感觉。' },
    en: { label: 'Lab', title: 'Hold if lift is unclear', text: 'Who sees what is a threshold call, not a hunch.' },
  },
] as const;
---

<BaseLayout title={`派蒙三千问 | ${entry.data.title}`} description={entry.data.description} bodyClass="paimon-demo">
  <article class="paimon" data-lang="zh" data-pagefind-body>
    <header class="paimon-hero">
      <p class="paimon-back">
        <a href={`${base}projects/`}>← 作品</a>
      </p>

      <div class="paimon-hero__copy">
        <div class="paimon-hero__topline">
          <p class="paimon-kicker">
            <span data-lang-panel="zh">Demo · 至冬情报</span>
            <span data-lang-panel="en" hidden>Demo · Snezhnaya intel</span>
          </p>
          <div class="paimon-lang" role="group" aria-label="Language">
            <button type="button" data-lang-button="zh" aria-pressed="true">中</button>
            <button type="button" data-lang-button="en" aria-pressed="false">EN</button>
          </div>
        </div>

        <h1>
          <span data-lang-panel="zh">派蒙三千问</span>
          <span data-lang-panel="en" hidden>Paimon Asks Everything</span>
        </h1>
        <p class="paimon-hero__lead">
          <span data-lang-panel="zh">先让旅行者看懂版本，再让制作组验证增量。</span>
          <span data-lang-panel="en" hidden>Help travelers understand the update. Help the team prove the lift.</span>
        </p>

        <div class="paimon-hero__actions">
          {
            liveLink && (
              <a class="paimon-btn paimon-btn--solid" href={resolveHref(liveLink.href)} target="_blank" rel="noopener">
                <span data-lang-panel="zh">打开 Demo</span>
                <span data-lang-panel="en" hidden>Open demo</span>
              </a>
            )
          }
          {
            repoLink && (
              <a class="paimon-btn" href={resolveHref(repoLink.href)} target="_blank" rel="noopener">
                GitHub
              </a>
            )
          }
        </div>
      </div>

      <figure class="paimon-device">
        <img
          src={`${shots}home.webp`}
          alt="派蒙三千问首页：深蓝侧栏与至冬生态短片。"
          width="1600"
          height="900"
          loading="eager"
          decoding="async"
        />
      </figure>
    </header>

    <section class="paimon-tour" aria-labelledby="paimon-tour-title">
      <div class="paimon-tour__intro">
        <p class="paimon-kicker">Walkthrough</p>
        <h2 id="paimon-tour-title">
          <span data-lang-panel="zh">五站，一条线</span>
          <span data-lang-panel="en" hidden>Five stops, one loop</span>
        </h2>
      </div>

      <div class="paimon-rail" role="tablist" aria-label="Product stops">
        {
          stops.map((stop, index) => (
            <button
              type="button"
              class="paimon-rail__btn"
              role="tab"
              id={`paimon-tab-${stop.id}`}
              data-stop={stop.id}
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`paimon-panel-${stop.id}`}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
              <b data-lang-panel="zh">{stop.zh.label}</b>
              <b data-lang-panel="en" hidden>{stop.en.label}</b>
            </button>
          ))
        }
      </div>

      {
        stops.map((stop, index) => (
          <article
            class="paimon-panel"
            id={`paimon-panel-${stop.id}`}
            role="tabpanel"
            aria-labelledby={`paimon-tab-${stop.id}`}
            data-stop-panel={stop.id}
            hidden={index !== 0}
          >
            <div class="paimon-panel__copy">
              <p class="paimon-kicker">
                <span data-lang-panel="zh">{stop.zh.label}</span>
                <span data-lang-panel="en" hidden>{stop.en.label}</span>
              </p>
              <h3>
                <span data-lang-panel="zh">{stop.zh.title}</span>
                <span data-lang-panel="en" hidden>{stop.en.title}</span>
              </h3>
              <p>
                <span data-lang-panel="zh">{stop.zh.text}</span>
                <span data-lang-panel="en" hidden>{stop.en.text}</span>
              </p>
            </div>
            <figure class="paimon-device paimon-device--stage">
              <img
                src={`${shots}${stop.shot}`}
                alt=""
                width="1600"
                height="900"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </figure>
          </article>
        ))
      }
    </section>

    <p class="paimon-note">
      <span data-lang-panel="zh">实验页用合成数据验证方法，不宣称真实留存。</span>
      <span data-lang-panel="en" hidden>The lab uses synthetic data to prove the method, not live retention.</span>
    </p>

    {
      liveLink && (
        <p class="paimon-end">
          <a class="paimon-btn paimon-btn--solid" href={resolveHref(liveLink.href)} target="_blank" rel="noopener">
            <span data-lang-panel="zh">去站点里走一遍</span>
            <span data-lang-panel="en" hidden>Walk through the live site</span>
          </a>
        </p>
      )
    }
  </article>
</BaseLayout>

<style>
  :global(body.paimon-demo) {
    --p-navy: #07131c;
    --p-ink: #10222c;
    --p-cream: #f3eee4;
    --p-gold: #c9a56a;
    --p-muted: color-mix(in srgb, var(--p-cream) 62%, #8aa0a8);
  }

  :global(body.paimon-demo .site-backdrop__sky) {
    background:
      radial-gradient(ellipse 70% 42% at 50% -8%, #163044, transparent 68%),
      linear-gradient(180deg, #0c1c26 0%, var(--p-navy) 48%);
  }

  :global(body.paimon-demo .forest-sprite) {
    display: none;
  }

  :global(body.paimon-demo .site-header) {
    background: color-mix(in srgb, #07131c 86%, transparent);
    border-bottom-color: color-mix(in srgb, #c9a56a 14%, transparent);
  }

  .paimon {
    width: min(100% - 2rem, 72rem);
    margin: 0 auto;
    padding: 1.5rem 0 5rem;
    color: var(--p-cream);
  }

  [data-lang-panel][hidden] {
    display: none !important;
  }

  .paimon-back {
    margin: 0 0 1.4rem;
  }

  .paimon-back a {
    color: var(--p-muted);
    font-family: var(--ch-display-font);
    font-size: 0.95rem;
    text-decoration: none;
  }

  .paimon-back a:hover,
  .paimon-back a:focus-visible {
    color: var(--p-gold);
  }

  .paimon-hero {
    display: grid;
    gap: 2rem;
  }

  .paimon-hero__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .paimon-kicker {
    margin: 0;
    color: var(--p-gold);
    font-family: var(--ch-mono-font);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .paimon-lang {
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    padding: 0.18rem;
    border: 1px solid color-mix(in srgb, var(--p-gold) 32%, transparent);
    border-radius: 999px;
  }

  .paimon-lang button {
    min-width: 2.6rem;
    min-height: 2rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--p-muted);
    cursor: pointer;
    font-family: var(--ch-mono-font);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .paimon-lang button[aria-pressed='true'] {
    background: color-mix(in srgb, var(--p-gold) 22%, transparent);
    color: var(--p-cream);
  }

  .paimon-hero h1 {
    margin: 0;
    color: var(--p-cream);
    font-family: var(--ch-display-font);
    font-size: clamp(3.2rem, 8vw, 6.4rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 0.92;
  }

  .paimon[data-lang='en'] .paimon-hero h1 {
    font-size: clamp(2.6rem, 6.2vw, 5.2rem);
    line-height: 0.98;
  }

  .paimon-hero__lead {
    max-width: 28rem;
    margin: 1.1rem 0 0;
    color: var(--p-muted);
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .paimon-hero__actions,
  .paimon-end {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }

  .paimon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.7rem;
    padding: 0.55rem 1.05rem;
    border: 1px solid color-mix(in srgb, var(--p-gold) 38%, transparent);
    border-radius: 999px;
    background: transparent;
    color: var(--p-cream);
    font-family: var(--ch-display-font);
    font-size: 1rem;
    text-decoration: none;
    transition: transform 160ms ease, background 160ms ease;
  }

  .paimon-btn:hover,
  .paimon-btn:focus-visible {
    transform: translateY(-1px);
  }

  .paimon-btn--solid {
    background: var(--p-cream);
    border-color: var(--p-cream);
    color: var(--p-navy);
  }

  .paimon-device {
    margin: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--p-gold) 24%, transparent);
    border-radius: 18px;
    background: var(--p-ink);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.38);
  }

  .paimon-device img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top left;
  }

  .paimon-device--stage img {
    height: 22rem;
    aspect-ratio: auto;
    object-position: top left;
  }

  .paimon-tour {
    margin-top: 4.5rem;
  }

  .paimon-tour__intro h2 {
    margin: 0.45rem 0 1.4rem;
    color: var(--p-cream);
    font-family: var(--ch-display-font);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 500;
  }

  .paimon-rail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0 0 1.4rem;
  }

  .paimon-rail::-webkit-scrollbar {
    display: none;
  }

  .paimon-rail__btn {
    display: grid;
    gap: 0.15rem;
    min-width: 6.4rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--p-cream) 12%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, var(--p-ink) 72%, transparent);
    color: var(--p-muted);
    cursor: pointer;
    text-align: left;
  }

  .paimon-rail__btn span {
    font-family: var(--ch-mono-font);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
  }

  .paimon-rail__btn b {
    color: var(--p-cream);
    font-family: var(--ch-display-font);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .paimon-rail__btn[aria-selected='true'] {
    border-color: color-mix(in srgb, var(--p-gold) 55%, transparent);
    background: color-mix(in srgb, var(--p-gold) 14%, var(--p-ink));
  }

  .paimon-panel {
    display: grid;
    grid-template-columns: minmax(12rem, 0.72fr) minmax(0, 1.28fr);
    gap: 1.2rem;
    align-items: center;
  }

  .paimon-panel[hidden] {
    display: none !important;
  }

  .paimon-panel__copy h3 {
    margin: 0.55rem 0 0;
    color: var(--p-cream);
    font-family: var(--ch-display-font);
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .paimon-panel__copy p {
    margin: 0.8rem 0 0;
    color: var(--p-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .paimon-note {
    margin: 2.2rem 0 0;
    color: color-mix(in srgb, var(--p-muted) 80%, transparent);
    font-size: 0.82rem;
  }

  .paimon-end {
    margin-top: 1.6rem;
  }

  @media (max-width: 860px) {
    .paimon-panel {
      grid-template-columns: 1fr;
    }

    .paimon-hero h1 {
      font-size: clamp(2.6rem, 16vw, 3.6rem);
    }

    .paimon-rail {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .paimon-rail::-webkit-scrollbar {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .paimon-hero,
    .paimon-tour {
      animation: paimon-in 640ms ease both;
    }

    .paimon-tour {
      animation-delay: 80ms;
    }
  }

  @keyframes paimon-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.paimon');
  if (root) {
    const langButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-lang-button]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-lang-panel]')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-stop]')];
    const stages = [...root.querySelectorAll<HTMLElement>('[data-stop-panel]')];

    const setLanguage = (lang: string) => {
      root.dataset.lang = lang;
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.langPanel !== lang;
      });
      langButtons.forEach((button) => {
        button.setAttribute('aria-pressed', button.dataset.langButton === lang ? 'true' : 'false');
      });
    };

    const setStop = (id: string) => {
      tabs.forEach((tab) => {
        tab.setAttribute('aria-selected', tab.dataset.stop === id ? 'true' : 'false');
      });
      stages.forEach((stage) => {
        stage.hidden = stage.dataset.stopPanel !== id;
      });
      const active = stages.find((stage) => stage.dataset.stopPanel === id);
      if (active) {
        const top = active.getBoundingClientRect().top + window.scrollY - 108;
        window.scrollTo({ top, behavior: 'smooth' });
      }
    };

    langButtons.forEach((button) => {
      button.addEventListener('click', () => setLanguage(button.dataset.langButton ?? 'zh'));
    });
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => setStop(tab.dataset.stop ?? 'intel'));
    });

    try {
      if (localStorage.getItem('paimon-case-lang') === 'en') setLanguage('en');
    } catch {
      setLanguage('zh');
    }

    langButtons.forEach((button) => {
      button.addEventListener('click', () => {
        try {
          localStorage.setItem('paimon-case-lang', button.dataset.langButton ?? 'zh');
        } catch {
          /* ignore */
        }
      });
    });
  }
</script>
